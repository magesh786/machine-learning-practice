 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","========== IMPORTANT SPAM WORDS ==========\n","['free' 'won' 'congratulations' 'claim' 'offer' 'reward' 'click'\n"," 'selected' 'congratulations won' 'won free' 'urgent' 'prize' 'limited'\n"," 'cash' 'today']\n","\n","========== IMPORTANT HAM WORDS ==========\n","['tomorrow' 'assignment' 'share' 'project' 'meeting' 'send' 'presentation'\n"," 'free' 'let' 'bonus' 'free weekend' 'weekend' 'free bonus'\n"," 'send assignment' 'tomorrow morning']\n","\n","Saved: naive_bayes_sms_predictions.csv\n","Saved: naive_bayes_alpha_experiment.csv\n","Saved: naive_bayes_model_summary.csv\n","\n","============================================\n","DAY 20 PROJECT COMPLETED\n","Naive Bayes - SMS Spam Detection\n","============================================\n","Accuracy : 0.8000\n","Precision: 1.0000\n","Recall   : 0.5000\n","F1 Score : 0.6667\n","\n","Generated Files:\n","1. naive_bayes_sms_predictions.csv\n","2. naive_bayes_alpha_experiment.csv\n","3. naive_bayes_model_summary.csv\n"]}],"source":["# ============================================================\n","# DAY 20 - NAIVE BAYES FOR TEXT CLASSIFICATION\n","# SMS Spam Detection\n","# Machine Learning Daily Series\n","# ============================================================\n","\n","# =========================\n","# 1. Import Libraries\n","# =========================\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","from sklearn.model_selection import train_test_split\n","from sklearn.feature_extraction.text import TfidfVectorizer\n","from sklearn.naive_bayes import MultinomialNB\n","from sklearn.metrics import (\n","    accuracy_score,\n","    precision_score,\n","    recall_score,\n","    f1_score,\n","    confusion_matrix,\n","    classification_report\n",")\n","\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","\n","# =========================\n","# 2. Create SMS Dataset\n","# =========================\n","\n","data = {\n","    \"label\": [\n","        \"ham\", \"ham\", \"spam\", \"ham\", \"spam\",\n","        \"ham\", \"ham\", \"spam\", \"ham\", \"spam\",\n","        \"ham\", \"ham\", \"spam\", \"ham\", \"spam\",\n","        \"ham\", \"ham\", \"spam\", \"ham\", \"spam\",\n","        \"ham\", \"ham\", \"spam\", \"ham\", \"spam\",\n","        \"ham\", \"spam\", \"ham\", \"spam\", \"ham\",\n","        \"ham\", \"spam\", \"ham\", \"spam\", \"ham\",\n","        \"ham\", \"spam\", \"ham\", \"spam\", \"ham\",\n","        \"ham\", \"spam\", \"ham\", \"spam\", \"ham\",\n","        \"spam\", \"ham\", \"spam\", \"ham\" # Removed one 'ham' to match message list length\n","    ],\n","\n","    \"message\": [\n","        \"Hey are we meeting today\",\n","        \"Can you send me the assignment\",\n","        \"Congratulations you won a free prize claim now\",\n","        \"Please call me when you reach home\",\n","        \"URGENT you have won 50000 cash call now\",\n","        \"Are you coming to college tomorrow\",\n","        \"Your project presentation is scheduled tomorrow\",\n","        \"You have been selected for a free vacation\",\n","        \"Can you share the notes with me\",\n","        \"Win a brand new phone by entering this contest\",\n","        \"I will call you after class\",\n","        \"Please submit the report before evening\",\n","        \"Exclusive offer click now to claim your reward\",\n","        \"Are you free this weekend\",\n","        \"You won a lottery ticket send your details\",\n","        \"Let's meet at the library\",\n","        \"Your exam timetable has been published\",\n","        \"Get free recharge now limited time offer\",\n","        \"Can you help me with Python code\",\n","        \"Congratulations claim your cash reward today\",\n","        \"I am waiting near the bus stop\",\n","        \"Please bring your laptop tomorrow\",\n","        \"Free entry available click the link now\",\n","        \"What time is the meeting\",\n","        \"You have won a shopping voucher\",\n","        \"I completed the machine learning assignment\",\n","        \"Win free tickets now reply YES\",\n","        \"Please send the project file\",\n","        \"Limited offer get free coupons today\",\n","        \"Are you attending the event\",\n","        \"Your attendance report is ready\",\n","        \"Congratulations you won a free gift\",\n","        \"Can you call me later\",\n","        \"Earn money quickly from home click now\",\n","        \"The class starts at ten tomorrow\",\n","        \"Free cash reward available claim immediately\",\n","        \"Please check your email\",\n","        \"You have won an exclusive prize\",\n","        \"I will send the documents tonight\",\n","        \"Get your free bonus now\",\n","        \"Let's discuss the project tomorrow\",\n","        \"Urgent claim your free reward\",\n","        \"Please remind me about the meeting\",\n","        \"You won a free vacation package\",\n","        \"I am working on the assignment\",\n","        \"Congratulations your number won a prize\",\n","        \"Can you share the presentation\",\n","        \"Free offer available for selected users\",\n","        \"See you tomorrow morning\"\n","    ]\n","}\n","\n","df = pd.DataFrame(data)\n","\n","print(\"Dataset Shape:\", df.shape)\n","\n","display(df.head(10))\n","\n","\n","# =========================\n","# 3. Dataset Information\n","# =========================\n","\n","print(\"\\nDataset Information:\")\n","df.info()\n","\n","print(\"\\nMissing Values:\")\n","print(df.isnull().sum())\n","\n","print(\"\\nClass Distribution:\")\n","print(df[\"label\"].value_counts())\n","\n","\n","# =========================\n","# 4. Visualize Class Distribution\n","# =========================\n","\n","class_counts = df[\"label\"].value_counts()\n","\n","plt.figure(figsize=(7, 5))\n","\n","plt.bar(\n","    class_counts.index,\n","    class_counts.values\n",")\n","\n","plt.xlabel(\"Message Type\")\n","plt.ylabel(\"Number of Messages\")\n","plt.title(\"SMS Message Class Distribution\")\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================\n","# 5. Convert Labels\n","# =========================\n","\n","df[\"target\"] = df[\"label\"].map({\n","    \"ham\": 0,\n","    \"spam\": 1\n","})\n","\n","print(\"\\nEncoded Labels:\")\n","display(df[[\"label\", \"target\"]].head())\n","\n","\n","# =========================\n","# 6. Features and Target\n","# =========================\n","\n","X = df[\"message\"]\n","y = df[\"target\"]\n","\n","\n","# =========================\n","# 7. Train-Test Split\n","# =========================\n","\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X,\n","    y,\n","    test_size=0.20,\n","    random_state=42,\n","    stratify=y\n",")\n","\n","print(\"\\nTraining Samples:\", len(X_train))\n","print(\"Testing Samples:\", len(X_test))\n","\n","\n","# =========================\n","# 8. TF-IDF Vectorization\n","# =========================\n","\n","vectorizer = TfidfVectorizer(\n","    lowercase=True,\n","    stop_words=\"english\",\n","    ngram_range=(1, 2)\n",")\n","\n","X_train_tfidf = vectorizer.fit_transform(\n","    X_train\n",")\n","\n","X_test_tfidf = vectorizer.transform(\n","    X_test\n",")\n","\n","print(\"\\nTF-IDF transformation completed.\")\n","\n","print(\n","    \"Training Matrix Shape:\",\n","    X_train_tfidf.shape\n",")\n","\n","print(\n","    \"Testing Matrix Shape:\",\n","    X_test_tfidf.shape\n",")\n","\n","\n","# =========================\n","# 9. Train Naive Bayes\n","# =========================\n","\n","model = MultinomialNB()\n","\n","model.fit(\n","    X_train_tfidf,\n","    y_train\n",")\n","\n","print(\n","    \"\\nMultinomial Naive Bayes \"\n","    \"model trained successfully!\"\n",")\n","\n","\n","# =========================\n","# 10. Predictions\n","# =========================\n","\n","y_pred = model.predict(\n","    X_test_tfidf\n",")\n","\n","y_probability = model.predict_proba(\n","    X_test_tfidf\n",")[:, 1]\n","\n","\n","# =========================\n","# 11. Model Evaluation\n","# =========================\n","\n","accuracy = accuracy_score(\n","    y_test,\n","    y_pred\n",")\n","\n","precision = precision_score(\n","    y_test,\n","    y_pred,\n","    zero_division=0\n",")\n","\n","recall = recall_score(\n","    y_test,\n","    y_pred,\n","    zero_division=0\n",")\n","\n","f1 = f1_score(\n","    y_test,\n","    y_pred,\n","    zero_division=0\n",")\n","\n","print(\"\\n========== MODEL PERFORMANCE ==========\")\n","\n","print(f\"Accuracy  : {accuracy:.4f}\")\n","print(f\"Precision : {precision:.4f}\")\n","print(f\"Recall    : {recall:.4f}\")\n","print(f\"F1 Score  : {f1:.4f}\")\n","\n","\n","# =========================\n","# 12. Classification Report\n","# =========================\n","\n","print(\"\\n========== CLASSIFICATION REPORT ==========\")\n","\n","print(\n","    classification_report(\n","        y_test,\n","        y_pred,\n","        target_names=[\n","            \"Ham\",\n","            \"Spam\"\n","        ],\n","        zero_division=0\n","    )\n",")\n","\n","\n","# =========================\n","# 13. Confusion Matrix\n","# =========================\n","\n","cm = confusion_matrix(\n","    y_test,\n","    y_pred\n",")\n","\n","print(\"\\nConfusion Matrix:\")\n","print(cm)\n","\n","plt.figure(figsize=(7, 6))\n","\n","plt.imshow(\n","    cm,\n","    interpolation=\"nearest\"\n",")\n","\n","plt.title(\n","    \"Naive Bayes Confusion Matrix\"\n",")\n","\n","plt.xlabel(\"Predicted Label\")\n","plt.ylabel(\"Actual Label\")\n","\n","plt.xticks(\n","    [0, 1],\n","    [\"Ham\", \"Spam\"]\n",")\n","\n","plt.yticks(\n","    [0, 1],\n","    [\"Ham\", \"Spam\"]\n",")\n","\n","for i in range(2):\n","    for j in range(2):\n","        plt.text(\n","            j,\n","            i,\n","            cm[i, j],\n","            ha=\"center\",\n","            va=\"center\"\n","        )\n","\n","plt.colorbar()\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================\n","# 14. Test Custom Messages\n","# =========================\n","\n","def classify_message(message):\n","\n","    message_vector = vectorizer.transform(\n","        [message]\n","    )\n","\n","    prediction = model.predict(\n","        message_vector\n","    )[0]\n","\n","    probability = model.predict_proba(\n","        message_vector\n","    )[0]\n","\n","    if prediction == 1:\n","        result = \"SPAM\"\n","        confidence = probability[1]\n","    else:\n","        result = \"HAM\"\n","        confidence = probability[0]\n","\n","    return result, confidence\n","\n","\n","# =========================\n","# 15. Custom Test Messages\n","# =========================\n","\n","test_messages = [\n","    \"Congratulations you won a free cash prize claim now\",\n","    \"Can you send me the college notes\",\n","    \"URGENT claim your free reward immediately\",\n","    \"Are we meeting at college tomorrow\"\n","]\n","\n","print(\"\\n========== CUSTOM MESSAGE PREDICTIONS ==========\")\n","\n","for message in test_messages:\n","\n","    result, confidence = classify_message(\n","        message\n","    )\n","\n","    print(\"\\nMessage:\", message)\n","    print(\"Prediction:\", result)\n","    print(\n","        \"Confidence:\",\n","        f\"{confidence * 100:.2f}%\"\n","    )\n","\n","\n","# =========================\n","# 16. Test Different Alpha Values\n","# =========================\n","\n","alpha_values = [\n","    0.01,\n","    0.1,\n","    0.5,\n","    1.0,\n","    2.0\n","]\n","\n","alpha_results = []\n","\n","for alpha in alpha_values:\n","\n","    alpha_model = MultinomialNB(\n","        alpha=alpha\n","    )\n","\n","    alpha_model.fit(\n","        X_train_tfidf,\n","        y_train\n","    )\n","\n","    alpha_predictions = (\n","        alpha_model.predict(\n","            X_test_tfidf\n","        )\n","    )\n","\n","    alpha_accuracy = accuracy_score(\n","        y_test,\n","        alpha_predictions\n","    )\n","\n","    alpha_results.append({\n","        \"Alpha\": alpha,\n","        \"Accuracy\": alpha_accuracy\n","    })\n","\n","\n","alpha_results = pd.DataFrame(\n","    alpha_results\n",")\n","\n","print(\n","    \"\\n========== ALPHA EXPERIMENT ==========\"\n",")\n","\n","display(alpha_results)\n","\n","\n","# =========================\n","# 17. Plot Alpha Experiment\n","# =========================\n","\n","plt.figure(figsize=(8, 5))\n","\n","plt.plot(\n","    alpha_results[\"Alpha\"],\n","    alpha_results[\"Accuracy\"],\n","    marker=\"o\"\n",")\n","\n","plt.xlabel(\"Alpha\")\n","plt.ylabel(\"Accuracy\")\n","\n","plt.title(\n","    \"Naive Bayes Alpha vs Accuracy\"\n",")\n","\n","plt.grid(alpha=0.3)\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================\n","# 18. Most Important Words\n","# =========================\n","\n","feature_names = np.array(\n","    vectorizer.get_feature_names_out()\n",")\n","\n","log_prob = model.feature_log_prob_\n","\n","spam_words = feature_names[\n","    np.argsort(log_prob[1])[-15:]\n","][::-1]\n","\n","ham_words = feature_names[\n","    np.argsort(log_prob[0])[-15:]\n","][::-1]\n","\n","print(\"\\n========== IMPORTANT SPAM WORDS ==========\")\n","\n","print(\n","    spam_words\n",")\n","\n","print(\"\\n========== IMPORTANT HAM WORDS ==========\")\n","\n","print(\n","    ham_words\n",")\n","\n","\n","# =========================\n","# 19. Save Predictions\n","# =========================\n","\n","prediction_results = pd.DataFrame({\n","    \"Message\": X_test.values,\n","    \"Actual\": y_test.values,\n","    \"Predicted\": y_pred,\n","    \"Spam_Probability\": y_probability\n","})\n","\n","prediction_results[\"Actual_Label\"] = (\n","    prediction_results[\"Actual\"]\n","    .map({\n","        0: \"Ham\",\n","        1: \"Spam\"\n","    })\n",")\n","\n","prediction_results[\"Predicted_Label\"] = (\n","    prediction_results[\"Predicted\"]\n","    .map({\n","        0: \"Ham\",\n","        1: \"Spam\"\n","    })\n",")\n","\n","prediction_results.to_csv(\n","    \"naive_bayes_sms_predictions.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"\\nSaved: naive_bayes_sms_predictions.csv\"\n",")\n","\n","\n","# =========================\n","# 20. Save Alpha Results\n","# =========================\n","\n","alpha_results.to_csv(\n","    \"naive_bayes_alpha_experiment.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"Saved: naive_bayes_alpha_experiment.csv\"\n",")\n","\n","\n","# =========================\n","# 21. Save Model Summary\n","# =========================\n","\n","model_summary = pd.DataFrame({\n","    \"Metric\": [\n","        \"Algorithm\",\n","        \"Vectorization\",\n","        \"Training Samples\",\n","        \"Testing Samples\",\n","        \"Accuracy\",\n","        \"Precision\",\n","        \"Recall\",\n","        \"F1 Score\"\n","    ],\n","\n","    \"Value\": [\n","        \"Multinomial Naive Bayes\",\n","        \"TF-IDF\",\n","        len(X_train),\n","        len(X_test),\n","        accuracy,\n","        precision,\n","        recall,\n","        f1\n","    ]\n","})\n","\n","model_summary.to_csv(\n","    \"naive_bayes_model_summary.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"Saved: naive_bayes_model_summary.csv\"\n",")\n","\n","\n","# =========================\n","# 22. Final Summary\n","# =========================\n","\n","print(\"\\n============================================\")\n","print(\"DAY 20 PROJECT COMPLETED\")\n","print(\"Naive Bayes - SMS Spam Detection\")\n","print(\"============================================\")\n","\n","print(\n","    f\"Accuracy : {accuracy:.4f}\"\n",")\n","\n","print(\n","    f\"Precision: {precision:.4f}\"\n",")\n","\n","print(\n","    f\"Recall   : {recall:.4f}\"\n",")\n","\n","print(\n","    f\"F1 Score : {f1:.4f}\"\n",")\n","\n","print(\"\\nGenerated Files:\")\n","\n","print(\n","    \"1. naive_bayes_sms_predictions.csv\"\n",")\n","\n","print(\n","    \"2. naive_bayes_alpha_experiment.csv\"\n",")\n","\n","print(\n","    \"3. naive_bayes_model_summary.csv\"\n",")\n"]}]}
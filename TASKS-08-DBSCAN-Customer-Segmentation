\"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Cluster\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0,\n        \"min\": 0,\n        \"max\": 0,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Customer segmentation results saved!\n","Cluster summary saved!\n","Outlier data saved!\n","\n","========================================\n","DAY 8 PROJECT COMPLETED!\n","Project: Customer Segmentation\n","Algorithm: DBSCAN\n","Learning Type: Unsupervised Learning\n","========================================\n"]}],"source":["# ============================================================\n","# DAY 8 - CUSTOMER SEGMENTATION USING DBSCAN\n","# Unsupervised Learning - Density Based Clustering\n","# ============================================================\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.cluster import DBSCAN\n","from sklearn.metrics import silhouette_score\n","\n","print(\"Libraries imported successfully!\")\n","\n","\n","# ============================================================\n","# 1. CREATE CUSTOMER DATASET\n","# ============================================================\n","\n","np.random.seed(42)\n","\n","# Customer groups\n","group1 = pd.DataFrame({\n","    \"Age\": np.random.normal(25, 3, 70),\n","    \"Annual_Income\": np.random.normal(30, 5, 70),\n","    \"Spending_Score\": np.random.normal(80, 8, 70)\n","})\n","\n","group2 = pd.DataFrame({\n","    \"Age\": np.random.normal(40, 4, 70),\n","    \"Annual_Income\": np.random.normal(65, 7, 70),\n","    \"Spending_Score\": np.random.normal(55, 8, 70)\n","})\n","\n","group3 = pd.DataFrame({\n","    \"Age\": np.random.normal(55, 4, 50),\n","    \"Annual_Income\": np.random.normal(90, 6, 50),\n","    \"Spending_Score\": np.random.normal(30, 7, 50)\n","})\n","\n","# Combine groups\n","df = pd.concat(\n","    [group1, group2, group3],\n","    ignore_index=True\n",")\n","\n","# Add some outliers\n","outliers = pd.DataFrame({\n","    \"Age\": [18, 70, 75, 20],\n","    \"Annual_Income\": [120, 10, 130, 5],\n","    \"Spending_Score\": [5, 95, 10, 100]\n","})\n","\n","df = pd.concat(\n","    [df, outliers],\n","    ignore_index=True\n",")\n","\n","# Add Customer ID\n","df.insert(\n","    0,\n","    \"Customer_ID\",\n","    range(1, len(df) + 1)\n",")\n","\n","print(\"\\nDataset created successfully!\")\n","\n","print(\"Dataset Shape:\", df.shape)\n","\n","display(df.head())\n","\n","\n","# ============================================================\n","# 2. DATASET INFORMATION\n","# ============================================================\n","\n","print(\"\\nDataset Information:\")\n","\n","df.info()\n","\n","\n","print(\"\\nMissing Values:\")\n","\n","print(df.isnull().sum())\n","\n","\n","print(\"\\nStatistical Summary:\")\n","\n","display(df.describe())\n","\n","\n","# ============================================================\n","# 3. SELECT FEATURES\n","# ============================================================\n","\n","features = [\n","    \"Age\",\n","    \"Annual_Income\",\n","    \"Spending_Score\"\n","]\n","\n","X = df[features]\n","\n","print(\"\\nFeatures used for clustering:\")\n","\n","print(features)\n","\n","\n","# ============================================================\n","# 4. FEATURE SCALING\n","# ============================================================\n","\n","scaler = StandardScaler()\n","\n","X_scaled = scaler.fit_transform(X)\n","\n","print(\"\\nFeature scaling completed!\")\n","\n","\n","# ============================================================\n","# 5. VISUALIZE ORIGINAL DATA\n","# ============================================================\n","\n","plt.figure(figsize=(9, 6))\n","\n","sns.scatterplot(\n","    data=df,\n","    x=\"Annual_Income\",\n","    y=\"Spending_Score\",\n","    s=80\n",")\n","\n","plt.title(\"Customer Data Before DBSCAN\")\n","plt.xlabel(\"Annual Income\")\n","plt.ylabel(\"Spending Score\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 6. CREATE DBSCAN MODEL\n","# ============================================================\n","\n","dbscan = DBSCAN(\n","    eps=0.45,\n","    min_samples=8\n",")\n","\n","print(\"\\nDBSCAN model created!\")\n","\n","\n","# ============================================================\n","# 7. TRAIN DBSCAN\n","# ============================================================\n","\n","labels = dbscan.fit_predict(X_scaled)\n","\n","df[\"Cluster\"] = labels\n","\n","print(\"\\nDBSCAN clustering completed!\")\n","\n","\n","# ============================================================\n","# 8. DISPLAY CLUSTER LABELS\n","# ============================================================\n","\n","print(\"\\nCluster Labels:\")\n","\n","print(\n","    df[\"Cluster\"]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","\n","# ============================================================\n","# 9. IDENTIFY NOISE / OUTLIERS\n","# ============================================================\n","\n","noise_count = np.sum(labels == -1)\n","\n","print(\"\\nNumber of Noise / Outlier Points:\")\n","\n","print(noise_count)\n","\n","\n","# ============================================================\n","# 10. CUSTOMER CLUSTER VISUALIZATION\n","# ============================================================\n","\n","plt.figure(figsize=(10, 7))\n","\n","sns.scatterplot(\n","    data=df,\n","    x=\"Annual_Income\",\n","    y=\"Spending_Score\",\n","    hue=\"Cluster\",\n","    palette=\"tab10\",\n","    s=100\n",")\n","\n","plt.title(\"Customer Segmentation using DBSCAN\")\n","plt.xlabel(\"Annual Income\")\n","plt.ylabel(\"Spending Score\")\n","\n","plt.legend(title=\"Cluster\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 11. AGE VS SPENDING SCORE\n","# ============================================================\n","\n","plt.figure(figsize=(10, 7))\n","\n","sns.scatterplot(\n","    data=df,\n","    x=\"Age\",\n","    y=\"Spending_Score\",\n","    hue=\"Cluster\",\n","    palette=\"tab10\",\n","    s=100\n",")\n","\n","plt.title(\"Age vs Spending Score - DBSCAN\")\n","plt.xlabel(\"Age\")\n","plt.ylabel(\"Spending Score\")\n","\n","plt.legend(title=\"Cluster\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 12. CLUSTER COUNTS\n","# ============================================================\n","\n","cluster_counts = (\n","    df[\"Cluster\"]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","print(\"\\nCluster Counts:\")\n","\n","display(cluster_counts)\n","\n","\n","# ============================================================\n","# 13. CLUSTER SIZE GRAPH\n","# ============================================================\n","\n","plt.figure(figsize=(9, 5))\n","\n","sns.barplot(\n","    x=cluster_counts.index.astype(str),\n","    y=cluster_counts.values\n",")\n","\n","plt.title(\"DBSCAN Cluster Distribution\")\n","plt.xlabel(\"Cluster\")\n","plt.ylabel(\"Number of Customers\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 14. SILHOUETTE SCORE\n","# ============================================================\n","\n","# Silhouette score requires at least 2 clusters\n","# and excludes DBSCAN noise points.\n","\n","non_noise_mask = labels != -1\n","\n","X_clustered = X_scaled[non_noise_mask]\n","\n","labels_clustered = labels[non_noise_mask]\n","\n","unique_clusters = np.unique(labels_clustered)\n","\n","if len(unique_clusters) >= 2:\n","\n","    score = silhouette_score(\n","        X_clustered
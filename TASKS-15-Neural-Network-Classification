eted successfully! 🚀\n"]}],"source":["# ============================================================\n","# DAY 15 - NEURAL NETWORK CLASSIFICATION\n","# Breast Cancer Classification using MLPClassifier\n","# ============================================================\n","\n","# If running in Google Colab, uncomment:\n","# !pip install scikit-learn pandas numpy matplotlib seaborn -q\n","\n","# ============================================================\n","# 1. Import Libraries\n","# ============================================================\n","\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","from sklearn.datasets import load_breast_cancer\n","from sklearn.model_selection import train_test_split\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.neural_network import MLPClassifier\n","\n","from sklearn.metrics import (\n","    accuracy_score,\n","    classification_report,\n","    confusion_matrix\n",")\n","\n","# ============================================================\n","# 2. Load Dataset\n","# ============================================================\n","\n","data = load_breast_cancer()\n","\n","X = data.data\n","y = data.target\n","\n","feature_names = data.feature_names\n","target_names = data.target_names\n","\n","print(\"Dataset Shape:\", X.shape)\n","print(\"Number of Features:\", X.shape[1])\n","print(\"Target Classes:\", target_names)\n","\n","# ============================================================\n","# 3. Convert Dataset to DataFrame\n","# ============================================================\n","\n","df = pd.DataFrame(X, columns=feature_names)\n","\n","df[\"target\"] = y\n","\n","df[\"diagnosis\"] = df[\"target\"].map({\n","    0: \"Malignant\",\n","    1: \"Benign\"\n","})\n","\n","print(\"\\nFirst 5 Rows:\")\n","print(df.head())\n","\n","# ============================================================\n","# 4. Check Class Distribution\n","# ============================================================\n","\n","print(\"\\nClass Distribution:\")\n","print(df[\"diagnosis\"].value_counts())\n","\n","plt.figure(figsize=(7, 5))\n","\n","sns.countplot(\n","    data=df,\n","    x=\"diagnosis\"\n",")\n","\n","plt.title(\"Breast Cancer Class Distribution\")\n","plt.xlabel(\"Diagnosis\")\n","plt.ylabel(\"Count\")\n","\n","plt.show()\n","\n","# ============================================================\n","# 5. Train-Test Split\n","# ============================================================\n","\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X,\n","    y,\n","    test_size=0.20,\n","    random_state=42,\n","    stratify=y\n",")\n","\n","print(\"\\nTraining Samples:\", len(X_train))\n","print(\"Testing Samples:\", len(X_test))\n","\n","# ============================================================\n","# 6. Feature Scaling\n","# ============================================================\n","\n","scaler = StandardScaler()\n","\n","X_train_scaled = scaler.fit_transform(X_train)\n","X_test_scaled = scaler.transform(X_test)\n","\n","print(\"\\nFeature scaling completed.\")\n","\n","# ============================================================\n","# 7. Build Neural Network\n","# ============================================================\n","\n","model = MLPClassifier(\n","    hidden_layer_sizes=(64, 32),\n","    activation=\"relu\",\n","    solver=\"adam\",\n","    alpha=0.0001,\n","    learning_rate_init=0.001,\n","    max_iter=1000,\n","    random_state=42,\n","    early_stopping=True,\n","    validation_fraction=0.15,\n","    n_iter_no_change=20\n",")\n","\n","print(\"\\nNeural Network Architecture:\")\n","print(\"Input Layer  :\", X_train_scaled.shape[1], \"neurons\")\n","print(\"Hidden Layer 1: 64 neurons\")\n","print(\"Hidden Layer 2: 32 neurons\")\n","print(\"Output Layer :\", 1, \"output\")\n","\n","# ============================================================\n","# 8. Train Model\n","# ============================================================\n","\n","model.fit(\n","    X_train_scaled,\n","    y_train\n",")\n","\n","print(\"\\nModel training completed.\")\n","print(\"Training Iterations:\", model.n_iter_)\n","\n","# ============================================================\n","# 9. Make Predictions\n","# ============================================================\n","\n","y_pred = model.predict(X_test_scaled)\n","\n","y_probability = model.predict_proba(\n","    X_test_scaled\n",")\n","\n","# ============================================================\n","# 10. Model Accuracy\n","# ============================================================\n","\n","accuracy = accuracy_score(\n","    y_test,\n","    y_pred\n",")\n","\n","print(\"\\n====================================\")\n","print(\"MODEL PERFORMANCE\")\n","print(\"====================================\")\n","\n","print(\"Accuracy:\", round(accuracy * 100, 2), \"%\")\n","\n","# ============================================================\n","# 11. Classification Report\n","# ============================================================\n","\n","print(\"\\nClassification Report:\")\n","\n","print(\n","    classification_report(\n","        y_test,\n","        y_pred,\n","        target_names=target_names\n","    )\n",")\n","\n","# ============================================================\n","# 12. Confusion Matrix\n","# ============================================================\n","\n","cm = confusion_matrix(\n","    y_test,\n","    y_pred\n",")\n","\n","plt.figure(figsize=(7, 5))\n","\n","sns.heatmap(\n","    cm,\n","    annot=True,\n","    fmt=\"d\",\n","    cmap=\"Blues\",\n","    xticklabels=target_names,\n","    yticklabels=target_names\n",")\n","\n","plt.title(\"Neural Network Confusion Matrix\")\n","plt.xlabel(\"Predicted\")\n","plt.ylabel(\"Actual\")\n","\n","plt.show()\n","\n","# ============================================================\n","# 13. Prediction Results\n","# ============================================================\n","\n","prediction_df = pd.DataFrame({\n","    \"Actual\": [\n","        target_names[value]\n","        for value in y_test\n","    ],\n","\n","    \"Predicted\": [\n","        target_names[value]\n","        for value in y_pred\n","    ],\n","\n","    \"Malignant_Probability\": y_probability[:, 0],\n","\n","    \"Benign_Probability\": y_probability[:, 1]\n","})\n","\n","print(\"\\nPrediction Results:\")\n","print(prediction_df.head(10))\n","\n","# ============================================================\n","# 14. Neural Network Loss Curve\n","# ============================================================\n","\n","plt.figure(figsize=(8, 5))\n","\n","plt.plot(\n","    model.loss_curve_\n",")\n","\n","plt.title(\"Neural Network Training Loss\")\n","plt.xlabel(\"Iterations\")\n","plt.ylabel(\"Loss\")\n","\n","plt.grid(True)\n","\n","plt.show()\n","\n","# ============================================================\n","# 15. Custom Prediction Function\n","# ============================================================\n","\n","def predict_sample(sample):\n","\n","    sample = np.array(sample).reshape(1, -1)\n","\n","    sample_scaled = scaler.transform(sample)\n","\n","    prediction = model.predict(\n","        sample_scaled\n","    )[0]\n","\n","    probability = model.predict_proba(\n","        sample_scaled\n","    )[0]\n","\n","    print(\"\\nPrediction:\")\n","    print(\"Diagnosis:\", target_names[prediction])\n","\n","    print(\n","        \"Malignant Probability:\",\n","        round(probability[0] * 100, 2),\n","        \"%\"\n","    )\n","\n","    print(\n","        \"Benign Probability:\",\n","        round(probability[1] * 100, 2),\n","        \"%\"\n","    )\n","\n","\n","# Example using first test sample\n","predict_sample(X_test[0])\n","\n","# ============================================================\n","# 16. Model Summary\n","# ============================================================\n","\n","model_summary = pd.DataFrame({\n","    \"Model\": [\"MLPClassifier\"],\n","    \"Architecture\": [\"64 → 32\"],\n","    \"Activation\": [\"ReLU\"],\n","    \"Optimizer\": [\"Adam\"],\n","    \"Training_Samples\": [len(X_train)],\n","    \"Testing_Samples\": [len(X_test)],\n","    \"Features\": [X.shape[1]],\n","    \"Iterations\": [model.n_iter_],\n","    \"Accuracy\": [accuracy]\n","})\n","\n","print(\"\\nModel Summary:\")\n","print(model_summary)\n","\n","# ============================================================\n","# 17. Save Results\n","# ============================================================\n","\n","prediction_df.to_csv(\n","    \"neural_network_predictions.csv\",\n","    index=False\n",")\n","\n","model_summary.to_csv(\n","    \"neural_network_model_summary.csv\",\n","    index=False\n",")\n","\n","# Save loss curve\n","loss_df = pd.DataFrame({\n","    \"Iteration\": range(\n","        1,\n","        len(model.loss_curve_) + 1\n","    ),\n","    \"Loss\": model.loss_curve_\n","})\n","\n","loss_df.to_csv(\n","    \"neural_network_loss_curve.csv\",\n","    index=False\n",")\n","\n","print(\"\\n====================================\")\n","print(\"FILES SAVED SUCCESSFULLY\")\n","print(\"====================================\")\n","\n","print(\"neural_network_predictions.csv\")\n","print(\"neural_network_model_summary.csv\")\n","print(\"neural_network_loss_curve.csv\")\n","\n","print(\"\\nDay 15 completed successfully! 🚀\")"]}]}
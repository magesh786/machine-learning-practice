dout","text":["\n","Model summary saved!\n","\n","========================================\n","DAY 13 PROJECT COMPLETED!\n","========================================\n","Project: Spam Detection\n","Algorithm: Multinomial Naive Bayes\n","Learning Type: Supervised Learning\n","Text Representation: TF-IDF\n","Training Samples: 32\n","Testing Samples: 8\n","Vocabulary Size: 69\n","Accuracy: 100.0 %\n","========================================\n"]}],"source":["# ============================================================\n","# DAY 13 - EMAIL SPAM DETECTION USING NAIVE BAYES\n","# Multinomial Naive Bayes + TF-IDF\n","# ============================================================\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","from sklearn.model_selection import train_test_split\n","from sklearn.feature_extraction.text import TfidfVectorizer\n","from sklearn.naive_bayes import MultinomialNB\n","\n","from sklearn.metrics import (\n","    accuracy_score,\n","    classification_report,\n","    confusion_matrix,\n","    ConfusionMatrixDisplay\n",")\n","\n","print(\"Libraries imported successfully!\")\n","\n","\n","# ============================================================\n","# 1. CREATE TEXT DATASET\n","# ============================================================\n","\n","data = {\n","    \"message\": [\n","        \"Congratulations you won a free lottery prize\",\n","        \"Claim your free cash reward now\",\n","        \"You have won a free vacation\",\n","        \"Urgent claim your prize immediately\",\n","        \"Get free money by clicking this link\",\n","        \"Congratulations your mobile number won a prize\",\n","        \"Win a free shopping voucher today\",\n","        \"Exclusive offer claim your cash reward\",\n","        \"You are selected for a free gift\",\n","        \"Click now to receive your free reward\",\n","\n","        \"Can we meet tomorrow for the project\",\n","        \"Please send me the assignment notes\",\n","        \"The meeting is scheduled at 10 AM\",\n","        \"Don't forget to submit your project\",\n","        \"Can you share the Python code\",\n","        \"I will call you after class\",\n","        \"Please attend the department meeting\",\n","        \"The exam timetable has been released\",\n","        \"Let's work on the machine learning project\",\n","        \"Can you send me the presentation\",\n","\n","        \"You have won a lottery ticket\",\n","        \"Free prize waiting for you\",\n","        \"Claim your reward before midnight\",\n","        \"Congratulations you are a lucky winner\",\n","        \"Get your free bonus now\",\n","        \"You have been selected for cash prize\",\n","        \"Free recharge available click now\",\n","        \"Win exciting rewards today\",\n","        \"Claim your free shopping coupon\",\n","        \"Urgent free offer just for you\",\n","\n","        \"Please review the project report\",\n","        \"The lab starts at 9 AM tomorrow\",\n","        \"Let's discuss our project today\",\n","        \"Send the database assignment\",\n","        \"Please check the GitHub repository\",\n","        \"The seminar will begin at 2 PM\",\n","        \"Can you help me with the assignment\",\n","        \"Our team meeting is tomorrow\",\n","        \"Please bring your laptop to class\",\n","        \"Let's complete the project before Friday\"\n","    ],\n","\n","    \"label\": [\n","        \"spam\", \"spam\", \"spam\", \"spam\", \"spam\",\n","        \"spam\", \"spam\", \"spam\", \"spam\", \"spam\",\n","\n","        \"ham\", \"ham\", \"ham\", \"ham\", \"ham\",\n","        \"ham\", \"ham\", \"ham\", \"ham\", \"ham\",\n","\n","        \"spam\", \"spam\", \"spam\", \"spam\", \"spam\",\n","        \"spam\", \"spam\", \"spam\", \"spam\", \"spam\",\n","\n","        \"ham\", \"ham\", \"ham\", \"ham\", \"ham\",\n","        \"ham\", \"ham\", \"ham\", \"ham\", \"ham\"\n","    ]\n","}\n","\n","df = pd.DataFrame(data)\n","\n","print(\"\\nDataset created successfully!\")\n","print(\"Dataset Shape:\", df.shape)\n","\n","display(df.head())\n","\n","\n","# ============================================================\n","# 2. DATASET INFORMATION\n","# ============================================================\n","\n","print(\"\\nDataset Information:\")\n","df.info()\n","\n","print(\"\\nMissing Values:\")\n","print(df.isnull().sum())\n","\n","print(\"\\nClass Distribution:\")\n","print(df[\"label\"].value_counts())\n","\n","\n","# ============================================================\n","# 3. CLASS DISTRIBUTION VISUALIZATION\n","# ============================================================\n","\n","plt.figure(figsize=(8, 5))\n","\n","sns.countplot(\n","    data=df,\n","    x=\"label\"\n",")\n","\n","plt.title(\"Spam vs Ham Message Distribution\")\n","plt.xlabel(\"Message Type\")\n","plt.ylabel(\"Number of Messages\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 4. CONVERT LABELS INTO NUMBERS\n","# ============================================================\n","\n","df[\"target\"] = df[\"label\"].map({\n","    \"ham\": 0,\n","    \"spam\": 1\n","})\n","\n","print(\"\\nEncoded Labels:\")\n","display(df.head())\n","\n","\n","# ============================================================\n","# 5. SEPARATE FEATURES AND TARGET\n","# ============================================================\n","\n","X = df[\"message\"]\n","y = df[\"target\"]\n","\n","print(\"\\nNumber of Messages:\", len(X))\n","\n","\n","# ============================================================\n","# 6. TRAIN TEST SPLIT\n","# ============================================================\n","\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X,\n","    y,\n","    test_size=0.20,\n","    random_state=42,\n","    stratify=y\n",")\n","\n","print(\"\\nTraining Messages:\", len(X_train))\n","print(\"Testing Messages:\", len(X_test))\n","\n","\n","# ============================================================\n","# 7. TF-IDF VECTORIZATION\n","# ============================================================\n","\n","vectorizer = TfidfVectorizer(\n","    lowercase=True,\n","    stop_words=\"english\",\n","    max_features=1000\n",")\n","\n","X_train_tfidf = vectorizer.fit_transform(\n","    X_train\n",")\n","\n","X_test_tfidf = vectorizer.transform(\n","    X_test\n",")\n","\n","print(\"\\nTF-IDF vectorization completed!\")\n","\n","print(\n","    \"Training Matrix Shape:\",\n","    X_train_tfidf.shape\n",")\n","\n","print(\n","    \"Testing Matrix Shape:\",\n","    X_test_tfidf.shape\n",")\n","\n","\n","# ============================================================\n","# 8. DISPLAY IMPORTANT WORDS\n","# ============================================================\n","\n","feature_names = vectorizer.get_feature_names_out()\n","\n","print(\"\\nNumber of Vocabulary Words:\")\n","print(len(feature_names))\n","\n","print(\"\\nFirst 30 Vocabulary Words:\")\n","print(feature_names[:30])\n","\n","\n","# ============================================================\n","# 9. CREATE NAIVE BAYES MODEL\n","# ============================================================\n","\n","model = MultinomialNB()\n","\n","print(\"\\nMultinomial Naive Bayes model created!\")\n","\n","\n","# ============================================================\n","# 10. TRAIN MODEL\n","# ============================================================\n","\n","model.fit(\n","    X_train_tfidf,\n","    y_train\n",")\n","\n","print(\"\\nModel training completed!\")\n","\n","\n","# ============================================================\n","# 11. MAKE PREDICTIONS\n","# ============================================================\n","\n","y_pred = model.predict(\n","    X_test_tfidf\n",")\n","\n","print(\"\\nPredictions completed!\")\n","\n","\n","# ============================================================\n
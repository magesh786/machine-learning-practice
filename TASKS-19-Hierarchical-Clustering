{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyORLd7GTqVFuBSRBbaNsszJ"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"iIBzbc-FNfiL"},"outputs":[],"source":["# ============================================================\n","# DAY 19 - HIERARCHICAL CLUSTERING\n","# Customer Segmentation using Agglomerative Clustering\n","# Machine Learning Daily Series\n","# ============================================================\n","\n","# =========================\n","# 1. Import Libraries\n","# =========================\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","from sklearn.cluster import AgglomerativeClustering\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.metrics import silhouette_score\n","\n","from scipy.cluster.hierarchy import dendrogram, linkage\n","\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","\n","# =========================\n","# 2. Create Customer Dataset\n","# =========================\n","\n","np.random.seed(42)\n","\n","n_customers = 300\n","\n","customer_data = pd.DataFrame({\n","    \"Annual_Income\": np.random.randint(\n","        15000, 120000, n_customers\n","    ),\n","\n","    \"Spending_Score\": np.random.randint(\n","        1, 101, n_customers\n","    ),\n","\n","    \"Age\": np.random.randint(\n","        18, 65, n_customers\n","    ),\n","\n","    \"Purchase_Frequency\": np.random.randint(\n","        1, 30, n_customers\n","    )\n","})\n","\n","# Add Customer ID\n","customer_data.insert(\n","    0,\n","    \"Customer_ID\",\n","    range(1, n_customers + 1)\n",")\n","\n","print(\"Dataset Shape:\", customer_data.shape)\n","\n","display(customer_data.head())\n","\n","\n","# =========================\n","# 3. Dataset Information\n","# =========================\n","\n","print(\"\\nDataset Information:\")\n","customer_data.info()\n","\n","print(\"\\nMissing Values:\")\n","print(customer_data.isnull().sum())\n","\n","print(\"\\nStatistical Summary:\")\n","display(customer_data.describe())\n","\n","\n","# =========================\n","# 4. Select Features\n","# =========================\n","\n","features = [\n","    \"Annual_Income\",\n","    \"Spending_Score\",\n","    \"Age\",\n","    \"Purchase_Frequency\"\n","]\n","\n","X = customer_data[features]\n","\n","print(\"\\nFeatures Used:\")\n","print(features)\n","\n","\n","# =========================\n","# 5. Feature Scaling\n","# =========================\n","\n","scaler = StandardScaler()\n","\n","X_scaled = scaler.fit_transform(X)\n","\n","print(\"\\nFeature scaling completed.\")\n","\n","\n","# =========================\n","# 6. Create Dendrogram\n","# =========================\n","\n","linked = linkage(\n","    X_scaled,\n","    method=\"ward\"\n",")\n","\n","plt.figure(figsize=(14, 7))\n","\n","dendrogram(\n","    linked,\n","    truncate_mode=\"lastp\",\n","    p=30,\n","    leaf_rotation=90,\n","    leaf_font_size=10\n",")\n","\n","plt.title(\n","    \"Hierarchical Clustering Dendrogram\"\n",")\n","\n","plt.xlabel(\"Customer Groups\")\n","plt.ylabel(\"Distance\")\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================\n","# 7. Agglomerative Clustering\n","# =========================\n","\n","n_clusters = 4\n","\n","hierarchical_model = AgglomerativeClustering(\n","    n_clusters=n_clusters,\n","    metric=\"euclidean\",\n","    linkage=\"ward\"\n",")\n","\n","cluster_labels = hierarchical_model.fit_predict(\n","    X_scaled\n",")\n","\n","customer_data[\"Cluster\"] = cluster_labels\n","\n","print(\"\\nHierarchical clustering completed.\")\n","\n","\n","# =========================\n","# 8. Cluster Distribution\n","# =========================\n","\n","cluster_counts = (\n","    customer_data[\"Cluster\"]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","print(\"\\n========== CLUSTER DISTRIBUTION ==========\")\n","print(cluster_counts)\n","\n","\n","# =========================\n","# 9. Silhouette Score\n","# =========================\n","\n","silhouette = silhouette_score(\n","    X_scaled,\n","    cluster_labels\n",")\n","\n","print(\n","    f\"\\nSilhouette Score: {silhouette:.4f}\"\n",")\n","\n","\n","# =========================\n","# 10. Visualize Clusters\n","# =========================\n","\n","plt.figure(figsize=(10, 7))\n","\n","for cluster in sorted(\n","    customer_data[\"Cluster\"].unique()\n","):\n","\n","    cluster_data = customer_data[\n","        customer_data[\"Cluster\"] == cluster\n","    ]\n","\n","    plt.scatter(\n","        cluster_data[\"Annual_Income\"],\n","        cluster_data[\"Spending_Score\"],\n","        alpha=0.7,\n","        label=f\"Cluster {cluster}\"\n","    )\n","\n","plt.xlabel(\"Annual Income\")\n","plt.ylabel(\"Spending Score\")\n","\n","plt.title(\n","    \"Hierarchical Clustering - Customer Segmentation\"\n",")\n","\n","plt.legend()\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================\n","# 11. Age vs Spending Score\n","# =========================\n","\n","plt.figure(figsize=(10, 7))\n","\n","for cluster in sorted(\n","    customer_data[\"Cluster\"].unique()\n","):\n","\n","    cluster_data = customer_data[\n","        customer_data[\"Cluster\"] == cluster\n","    ]\n","\n","    plt.scatter(\n","        cluster_data[\"Age\"],\n","        cluster_data[\"Spending_Score\"],\n","        alpha=0.7,\n","        label=f\"Cluster {cluster}\"\n","    )\n","\n","plt.xlabel(\"Age\")\n","plt.ylabel(\"Spending Score\")\n","\n","plt.title(\n","    \"Customer Age vs Spending Score\"\n",")\n","\n","plt.legend()\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================\n","# 12. Cluster Summary\n","# =========================\n","\n","cluster_summary = (\n","    customer_data\n","    .groupby(\"Cluster\")[features]\n","    .mean()\n","    .round(2)\n",")\n","\n","cluster_summary[\"Customer_Count\"] = (\n","    customer_data\n","    .groupby(\"Cluster\")\n","    .size()\n",")\n","\n","print(\"\\n========== CLUSTER SUMMARY ==========\")\n","\n","display(cluster_summary)\n","\n","\n","# =========================\n","# 13. Cluster Median\n","# =========================\n","\n","cluster_median = (\n","    customer_data\n","    .groupby(\"Cluster\")[features]\n","    .median()\n","    .round(2)\n",")\n","\n","print(\"\\n========== CLUSTER MEDIAN ==========\")\n","\n","display(cluster_median)\n","\n","\n","# =========================\n","# 14. Experiment with\n","#     Different Cluster Counts\n","# =========================\n","\n","cluster_values = [2, 3, 4, 5, 6, 7]\n","\n","experiment_results = []\n","\n","for k in cluster_values:\n","\n","    model = AgglomerativeClustering(\n","        n_clusters=k,\n","        metric=\"euclidean\",\n","        linkage=\"ward\"\n","    )\n","\n","    labels = model.fit_predict(\n","        X_scaled\n","    )\n","\n","    score = silhouette_score(\n","        X_scaled,\n","        labels\n","    )\n","\n","    experiment_results.append({\n","        \"Number_of_Clusters\": k,\n","        \"Silhouette_Score\": score\n","    })\n","\n","\n","experiment_results = pd.DataFrame(\n","    experiment_results\n",")\n","\n","print(\n","    \"\\n========== CLUSTER EXPERIMENT ==========\"\n",")\n","\n","display(experiment_results)\n","\n","\n","# =========================\n","# 15. Plot Cluster Experiment\n","# =========================\n","\n","plt.figure(figsize=(9, 6))\n","\n","plt.plot(\n","    experiment_results[\"Number_of_Clusters\"],\n","    experiment_results[\"Silhouette_Score\"],\n","    marker=\"o\"\n",")\n","\n","plt.xlabel(\"Number of Clusters\")\n","plt.ylabel(\"Silhouette Score\")\n","\n","plt.title(\n","    \"Number of Clusters vs Silhouette Score\"\n",")\n","\n","plt.xticks(cluster_values)\n","\n","plt.grid(alpha=0.3)\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================\n","# 16. Find Best Number\n","# =========================\n","\n","best_cluster_count = int(\n","    experiment_results.loc[\n","        experiment_results[\"Silhouette_Score\"].idxmax(),\n","        \"Number_of_Clusters\"\n","    ]\n",")\n","\n","best_silhouette = (\n","    experiment_results[\"Silhouette_Score\"].max()\n",")\n","\n","print(\n","    \"\\nBest Number of Clusters:\",\n","    best_cluster_count\n",")\n","\n","print(\n","    \"Best Silhouette Score:\",\n","    round(best_silhouette, 4)\n",")\n","\n","\n","# =========================\n","# 17. Train Best Model\n","# =========================\n","\n","best_model = AgglomerativeClustering(\n","    n_clusters=best_cluster_count,\n","    metric=\"euclidean\",\n","    linkage=\"ward\"\n",")\n","\n","best_labels = best_model.fit_predict(\n","    X_scaled\n",")\n","\n","customer_data[\"Best_Cluster\"] = best_labels\n","\n","\n","# =========================\n","# 18. Best Model Summary\n","# =========================\n","\n","best_cluster_summary = (\n","    customer_data\n","    .groupby(\"Best_Cluster\")[features]\n","    .mean()\n","    .round(2)\n",")\n","\n","best_cluster_summary[\"Customer_Count\"] = (\n","    customer_data\n","    .groupby(\"Best_Cluster\")\n","    .size()\n",")\n","\n","print(\n","    \"\\n========== BEST MODEL SUMMARY ==========\"\n",")\n","\n","display(best_cluster_summary)\n","\n","\n","# =========================\n","# 19. Assign Customer Segment\n","# =========================\n","\n","def assign_segment(row):\n","\n","    if row[\"Spending_Score\"] >= 70:\n","        return \"High Spenders\"\n","\n","    elif row[\"Spending_Score\"] <= 30:\n","        return \"Low Spenders\"\n","\n","    else:\n","        return \"Medium Spenders\"\n","\n","\n","customer_data[\"Customer_Segment\"] = (\n","    customer_data.apply(\n","        assign_segment,\n","        axis=1\n","    )\n",")\n","\n","print(\"\\nCustomer Segments:\")\n","display(\n","    customer_data[\n","        [\n","            \"Customer_ID\",\n","            \"Best_Cluster\",\n","            \"Customer_Segment\"\n","        ]\n","    ].head(10)\n",")\n","\n","\n","# =========================\n","# 20. Save Complete Dataset\n","# =========================\n","\n","customer_data.to_csv(\n","    \"hierarchical_customer_segmentation.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"\\nSaved: \"\n","    \"hierarchical_customer_segmentation.csv\"\n",")\n","\n","\n","# =========================\n","# 21. Save Cluster Summary\n","# =========================\n","\n","best_cluster_summary.to_csv(\n","    \"hierarchical_cluster_summary.csv\"\n",")\n","\n","print(\n","    \"Saved: hierarchical_cluster_summary.csv\"\n",")\n","\n","\n","# =========================\n","# 22. Save Experiment Results\n","# =========================\n","\n","experiment_results.to_csv(\n","    \"hierarchical_cluster_experiment.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"Saved: hierarchical_cluster_experiment.csv\"\n",")\n","\n","\n","# =========================\n","# 23. Save Model Summary\n","# =========================\n","\n","model_summary = pd.DataFrame({\n","    \"Metric\": [\n","        \"Algorithm\",\n","        \"Linkage\",\n","        \"Distance Metric\",\n","        \"Initial Clusters\",\n","        \"Best Clusters\",\n","        \"Initial Silhouette Score\",\n","        \"Best Silhouette Score\",\n","        \"Total Customers\"\n","    ],\n","\n","    \"Value\": [\n","        \"Agglomerative Clustering\",\n","        \"Ward\",\n","        \"Euclidean\",\n","        n_clusters,\n","        best_cluster_count,\n","        silhouette,\n","        best_silhouette,\n","        len(customer_data)\n","    ]\n","})\n","\n","model_summary.to_csv(\n","    \"hierarchical_model_summary.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"Saved: hierarchical_model_summary.csv\"\n",")\n","\n","\n","# =========================\n","# 24. Custom Customer\n","#     Prediction\n","# =========================\n","\n","def predict_customer_cluster(\n","    annual_income,\n","    spending_score,\n","    age,\n","    purchase_frequency\n","):\n","\n","    new_customer = pd.DataFrame([{\n","        \"Annual_Income\": annual_income,\n","        \"Spending_Score\": spending_score,\n","        \"Age\": age,\n","        \"Purchase_Frequency\":\n","            purchase_frequency\n","    }])\n","\n","    new_customer_scaled = scaler.transform(\n","        new_customer\n","    )\n","\n","    cluster = best_model.fit_predict(\n","        np.vstack([\n","            X_scaled,\n","            new_customer_scaled\n","        ])\n","    )[-1]\n","\n","    return cluster\n","\n","\n","# =========================\n","# 25. Test Custom Customer\n","# =========================\n","\n","custom_cluster = predict_customer_cluster(\n","    annual_income=85000,\n","    spending_score=90,\n","    age=28,\n","    purchase_frequency=20\n",")\n","\n","print(\n","    \"\\n========== CUSTOM CUSTOMER ==========\"\n",")\n","\n","print(\n","    \"Predicted Cluster:\",\n","    custom_cluster\n",")\n","\n","\n","# =========================\n","# 26. Final Summary\n","# =========================\n","\n","print(\"\\n============================================\")\n","print(\"DAY 19 PROJECT COMPLETED\")\n","print(\"Hierarchical Clustering - Customer Segmentation\")\n","print(\"============================================\")\n","\n","print(\n","    \"Initial Clusters:\",\n","    n_clusters\n",")\n","\n","print(\n","    \"Best Cluster Count:\",\n","    best_cluster_count\n",")\n","\n","print(\n","    \"Best Silhouette Score:\",\n","    round(best_silhouette, 4)\n",")\n","\n","print(\"\\nGenerated Files:\")\n","\n","print(\n","    \"1. hierarchical_customer_segmentation.csv\"\n",")\n","\n","print(\n","    \"2. hierarchical_cluster_summary.csv\"\n",")\n","\n","print(\n","    \"3. hierarchical_cluster_experiment.csv\"\n",")\n","\n","print(\n","    \"4. hierarchical_model_summary.csv\"\n",")"]}]}
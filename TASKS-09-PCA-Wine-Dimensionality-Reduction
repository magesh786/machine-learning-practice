sns\n","\n","from sklearn.datasets import load_wine\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.decomposition import PCA\n","\n","print(\"Libraries imported successfully!\")\n","\n","\n","# ============================================================\n","# 2. LOAD WINE DATASET\n","# ============================================================\n","\n","wine = load_wine()\n","\n","X = pd.DataFrame(\n","    wine.data,\n","    columns=wine.feature_names\n",")\n","\n","y = pd.Series(\n","    wine.target,\n","    name=\"Target\"\n",")\n","\n","df = X.copy()\n","df[\"Target\"] = y\n","\n","print(\"\\nDataset loaded successfully!\")\n","print(\"Dataset Shape:\", df.shape)\n","\n","display(df.head())\n","\n","\n","# ============================================================\n","# 3. DATASET INFORMATION\n","# ============================================================\n","\n","print(\"\\nDataset Information:\")\n","df.info()\n","\n","print(\"\\nMissing Values:\")\n","print(df.isnull().sum())\n","\n","print(\"\\nStatistical Summary:\")\n","display(df.describe())\n","\n","\n","# ============================================================\n","# 4. SEPARATE FEATURES AND TARGET\n","# ============================================================\n","\n","features = wine.feature_names\n","\n","X = df[features]\n","y = df[\"Target\"]\n","\n","print(\"\\nNumber of Features:\", X.shape[1])\n","print(\"Features:\")\n","print(features)\n","\n","\n","# ============================================================\n","# 5. FEATURE SCALING\n","# ============================================================\n","\n","scaler = StandardScaler()\n","\n","X_scaled = scaler.fit_transform(X)\n","\n","print(\"\\nFeature scaling completed!\")\n","\n","\n","# ============================================================\n","# 6. PCA WITH ALL COMPONENTS\n","# ============================================================\n","\n","pca_full = PCA()\n","\n","X_pca_full = pca_full.fit_transform(X_scaled)\n","\n","print(\"\\nPCA transformation completed!\")\n","\n","print(\"Original Number of Features:\", X.shape[1])\n","print(\"Number of PCA Components:\", X_pca_full.shape[1])\n","\n","\n","# ============================================================\n","# 7. EXPLAINED VARIANCE RATIO\n","# ============================================================\n","\n","explained_variance = pca_full.explained_variance_ratio_\n","\n","print(\"\\nExplained Variance Ratio:\")\n","for i, value in enumerate(explained_variance):\n","    print(\n","        f\"Principal Component {i+1}: \"\n","        f\"{value:.4f} \"\n","        f\"({value*100:.2f}%)\"\n","    )\n","\n","\n","# ============================================================\n","# 8. CUMULATIVE EXPLAINED VARIANCE\n","# ============================================================\n","\n","cumulative_variance = np.cumsum(explained_variance)\n","\n","print(\"\\nCumulative Explained Variance:\")\n","\n","for i, value in enumerate(cumulative_variance):\n","    print(\n","        f\"First {i+1} Components: \"\n","        f\"{value*100:.2f}%\"\n","    )\n","\n","\n","# ============================================================\n","# 9. EXPLAINED VARIANCE PLOT\n","# ============================================================\n","\n","plt.figure(figsize=(10, 6))\n","\n","plt.plot(\n","    range(1, len(explained_variance) + 1),\n","    cumulative_variance,\n","    marker=\"o\"\n",")\n","\n","plt.axhline(\n","    y=0.90,\n","    linestyle=\"--\",\n","    label=\"90% Variance\"\n",")\n","\n","plt.xlabel(\"Number of Principal Components\")\n","plt.ylabel(\"Cumulative Explained Variance\")\n","plt.title(\"PCA - Cumulative Explained Variance\")\n","\n","plt.xticks(\n","    range(1, len(explained_variance) + 1)\n",")\n","\n","plt.grid(True)\n","plt.legend()\n","plt.show()\n","\n","\n","# ============================================================\n","# 10. PCA WITH 2 COMPONENTS\n","# ============================================================\n","\n","pca = PCA(n_components=2)\n","\n","X_pca = pca.fit_transform(X_scaled)\n","\n","print(\"\\nPCA with 2 components completed!\")\n","\n","print(\"Original Shape:\", X_scaled.shape)\n","print(\"Reduced Shape:\", X_pca.shape)\n","\n","\n","# ============================================================\n","# 11. CREATE PCA DATAFRAME\n","# ============================================================\n","\n","pca_df = pd.DataFrame(\n","    X_pca,\n","    columns=[\"Principal_Component_1\",\n","             \"Principal_Component_2\"]\n",")\n","\n","pca_df[\"Target\"] = y.values\n","\n","print(\"\\nPCA Dataset:\")\n","display(pca_df.head())\n","\n","\n","# ============================================================\n","# 12. EXPLAINED VARIANCE OF 2 COMPONENTS\n","# ============================================================\n","\n","pca_variance = pca.explained_variance_ratio_\n","\n","print(\"\\nVariance Explained by 2 Components:\")\n","\n","print(\n","    \"Principal Component 1:\",\n","    round(pca_variance[0] * 100, 2),\n","    \"%\"\n",")\n","\n","print(\n","    \"Principal Component 2:\",\n","    round(pca_variance[1] * 100, 2),\n","    \"%\"\n",")\n","\n","print(\n","    \"Total Variance Explained:\",\n","    round(pca_variance.sum() * 100, 2),\n","    \"%\"\n",")\n","\n","\n","# ============================================================\n","# 13. PCA 2D VISUALIZATION\n","# ============================================================\n","\n","plt.figure(figsize=(10, 7))\n","\n","sns.scatterplot(\n","    data=pca_df,\n","    x=\"Principal_Component_1\",\n","    y=\"Principal_Component_2\",\n","    hue=\"Target\",\n","    palette=\"Set1\",\n","    s=100\n",")\n","\n","plt.title(\"Wine Dataset - PCA 2D Visualization\")\n","\n","plt.xlabel(\"Principal Component 1\")\n","plt.ylabel(\"Principal Component 2\")\n","\n","plt.legend(title=\"Wine Class\")\n","\n","plt.grid(True)\n","plt.show()\n","\n","\n","# ============================================================\n","# 14. PCA COMPONENT LOADINGS\n","# ============================================================\n","\n","loadings = pd.DataFrame(\n","    pca.components_.T,\n","    columns=[\n","        \"Principal_Component_1\",\n","        \"Principal_Component_2\"\n","    ],\n","    index=features\n",")\n","\n","print(\"\\nPCA Component Loadings:\")\n","display(loadings)\n","\n","\n","# ============================================================\n","# 15. FEATURE CONTRIBUTION VISUALIZATION\n","# ============================================================\n","\n","plt.figure(figsize=(12, 7))\n","\n","loadings[\"Principal_Component_1\"].sort_values().plot(\n","    kind=\"barh\"\n",")\n","\n","plt.title(\n","    \"Feature Contributions to Principal Component 1\"\n",")\n","\n","plt.xlabel(\"Loading\")\n","plt.ylabel(\"Feature\")\n","\n","plt.grid(True)\n","plt.show()\n","\n","\n","# ============================================================\n","# 16. COMPARE ORIGINAL AND REDUCED DATA\n","# ============================================================\n","\n","comparison = pd.DataFrame({\n","    \"Dataset\": [\n","        \"Original Dataset\",\n","        \"PCA Dataset\"\n","    ],\n","    \"Number_of_Features\": [\n","        X.shape[1],\n","        X_pca.shape[1]\n","    ]\n","})\n","\n","print(\"\\nDimensionality Comparison:\")\n","display(comparison)\n","\n","\n","# ============================================================\n","# 17. SAVE PCA RESULTS\n","# ============================================================\n","\n","pca_df.to_csv(\n","    \"wine_pca_results.csv\",\n","    index=False\n",")\n","\n","print(\"\\nPCA results saved as:\")\n","print(\"wine_pca_results.csv\")\n","\n","\n","# ============================================================\n","# 18. SAVE PCA LOADINGS\n","# ============================================================\n","\n","loadings.to_csv(\n","    \"pca_feature_loadings.csv\"\n",")\n","\n","print(\"\\nPCA feature loadings saved as:\")\n","print(\"pca_feature_loadings.csv\")\n","\n","\n","# ============================================================\n","# 19. SAVE EXPLAINED VARIANCE\n","# ============================================================\n","\n","variance_df = pd.DataFrame({\n","    \"Principal_Component\": range(\n","        1,\n","        len(explained_variance) + 1\n","    ),\n","    \"Explained_Variance\": explained_variance,\n","    \"Cumulative_Variance\": cumulative_variance\n","})\n","\n","variance_df.to_csv(\n","    \"pca_explained_variance.csv\",\n","    index=False\n",")\n","\n","print(\"\\nExplained variance saved as:\")\n","print(\"pca_explained_variance.csv\")\n","\n","\n","# ============================================================\n","# 20. FINAL OUTPUT\n","# ============================================================\n","\n","print(\"\\n========================================\")\n","print(\"DAY 9 PROJECT COMPLETED!\")\n","print(\"========================================\")\n","print(\"Project: Wine Dataset Dimensionality Reduction\")\n","print(\"Algorithm: PCA\")\n","print(\"Learning Type: Unsupervised Learning\")\n","print(\"Original Features:\", X.shape[1])\n","print(\"Reduced Features:\", X_pca.shape[1])\n","print(\n","    \"Variance Explained by 2 PCs:\",\n","    round(pca_variance.sum() * 100, 2),\n","    \"%\"\n",")\n","print(\"========================================\")"]}]}
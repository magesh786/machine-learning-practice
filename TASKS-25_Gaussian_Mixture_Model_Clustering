["# ============================================================\n","# DAY 25 - GAUSSIAN MIXTURE MODEL CLUSTERING\n","# Customer Segmentation using Gaussian Mixture Models\n","# ============================================================\n","\n","# ============================================================\n","# 1. IMPORT LIBRARIES\n","# ============================================================\n","\n","import os\n","import warnings\n","import joblib\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","from sklearn.datasets import make_blobs\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.decomposition import PCA\n","from sklearn.mixture import GaussianMixture\n","from sklearn.metrics import (\n","    silhouette_score,\n","    calinski_harabasz_score,\n","    davies_bouldin_score\n",")\n","\n","warnings.filterwarnings(\"ignore\")\n","\n","RANDOM_STATE = 42\n","\n","OUTPUT_DIR = \"day25_outputs\"\n","os.makedirs(OUTPUT_DIR, exist_ok=True)\n","\n","print(\"Libraries imported successfully.\")\n","\n","\n","# ============================================================\n","# 2. CREATE CUSTOMER DATASET\n","# ============================================================\n","\n","np.random.seed(RANDOM_STATE)\n","\n","n_customers = 1200\n","\n","# Generate customer behavioral data\n","annual_income = np.random.normal(\n","    loc=65000,\n","    scale=22000,\n","    size=n_customers\n",")\n","\n","annual_income = np.clip(\n","    annual_income,\n","    18000,\n","    150000\n",")\n","\n","age = np.random.normal(\n","    loc=35,\n","    scale=10,\n","    size=n_customers\n",")\n","\n","age = np.clip(age, 18, 70)\n","\n","purchase_frequency = np.random.gamma(\n","    shape=4,\n","    scale=3,\n","    size=n_customers\n",")\n","\n","purchase_frequency = np.clip(\n","    purchase_frequency,\n","    1,\n","    40\n",")\n","\n","average_order_value = (\n","    25\n","    + annual_income * 0.001\n","    + np.random.normal(0, 12, n_customers)\n",")\n","\n","average_order_value = np.clip(\n","    average_order_value,\n","    10,\n","    500\n",")\n","\n","website_visits = (\n","    20\n","    + purchase_frequency * 2\n","    + np.random.normal(0, 12, n_customers)\n",")\n","\n","website_visits = np.clip(\n","    website_visits,\n","    1,\n","    150\n",")\n","\n","discount_usage = (\n","    70\n","    - purchase_frequency * 1.5\n","    + np.random.normal(0, 15, n_customers)\n",")\n","\n","discount_usage = np.clip(\n","    discount_usage,\n","    0,\n","    100\n",")\n","\n","customer_df = pd.DataFrame({\n","    \"Customer_ID\": np.arange(1, n_customers + 1),\n","    \"Age\": age.round(1),\n","    \"Annual_Income\": annual_income.round(2),\n","    \"Purchase_Frequency\": purchase_frequency.round(2),\n","    \"Average_Order_Value\": average_order_value.round(2),\n","    \"Website_Visits\": website_visits.round(2),\n","    \"Discount_Usage\": discount_usage.round(2)\n","})\n","\n","print(\"Dataset shape:\", customer_df.shape)\n","\n","display(customer_df.head())\n","\n","\n","# ============================================================\n","# 3. DATA INFORMATION\n","# ============================================================\n","\n","print(\"\\nDataset Information:\")\n","customer_df.info()\n","\n","print(\"\\nMissing Values:\")\n","print(customer_df.isnull().sum())\n","\n","print(\"\\nStatistical Summary:\")\n","display(customer_df.describe())\n","\n","\n","# ============================================================\n","# 4. SAVE RAW DATASET\n","# ============================================================\n","\n","customer_df.to_csv(\n","    f\"{OUTPUT_DIR}/customer_dataset.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 5. SELECT FEATURES\n","# ============================================================\n","\n","features = [\n","    \"Age\",\n","    \"Annual_Income\",\n","    \"Purchase_Frequency\",\n","    \"Average_Order_Value\",\n","    \"Website_Visits\",\n","    \"Discount_Usage\"\n","]\n","\n","X = customer_df[features].copy()\n","\n","\n","# ============================================================\n","# 6. STANDARDIZE FEATURES\n","# ============================================================\n","\n","scaler = StandardScaler()\n","\n","X_scaled = scaler.fit_transform(X)\n","\n","print(\"Feature scaling completed.\")\n","\n","\n","# ============================================================\n","# 7. FIND OPTIMAL NUMBER OF COMPONENTS\n","#    USING AIC AND BIC\n","# ============================================================\n","\n","component_range = range(1, 16)\n","\n","aic_scores = []\n","bic_scores = []\n","log_likelihood_scores = []\n","\n","for n_components in component_range:\n","\n","    gmm = GaussianMixture(\n","        n_components=n_components,\n","        covariance_type=\"full\",\n","        random_state=RANDOM_STATE,\n","        n_init=10\n","    )\n","\n","    gmm.fit(X_scaled)\n","\n","    aic_scores.append(gmm.aic(X_scaled))\n","    bic_scores.append(gmm.bic(X_scaled))\n","    log_likelihood_scores.append(\n","        gmm.score(X_scaled)\n","    )\n","\n","model_selection_df = pd.DataFrame({\n","    \"n_components\": list(component_range),\n","    \"AIC\": aic_scores,\n","    \"BIC\": bic_scores,\n","    \"Average_Log_Likelihood\": log_likelihood_scores\n","})\n","\n","display(model_selection_df)\n","\n","\n","# ============================================================\n","# 8. SELECT COMPONENTS USING BIC\n","# ============================================================\n","\n","best_components_bic = int(\n","    model_selection_df.loc[\n","        model_selection_df[\"BIC\"].idxmin(),\n","        \"n_components\"\n","    ]\n",")\n","\n","best_components_aic = int(\n","    model_selection_df.loc[\n","        model_selection_df[\"AIC\"].idxmin(),\n","        \"n_components\"\n","    ]\n",")\n","\n","print(\"Best components according to BIC:\",\n","      best_components_bic)\n","\n","print(\"Best components according to AIC:\",\n","      best_components_aic)\n","\n","model_selection_df.to_csv(\n","    f\"{OUTPUT_DIR}/gmm_model_selection.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 9. VISUALIZE AIC AND BIC\n","# ============================================================\n","\n","plt.figure(figsize=(10, 6))\n","\n","plt.plot(\n","    model_selection_df[\"n_components\"],\n","    model_selection_df[\"AIC\"],\n","    marker=\"o\",\n","    label=\"AIC\"\n",")\n","\n","plt.plot(\n","    model_selection_df[\"n_components\"],\n","    model_selection_df[\"BIC\"],\n","    marker=\"o\",\n","    label=\"BIC\"\n",")\n","\n","plt.xlabel(\"Number of Gaussian Components\")\n","plt.ylabel(\"Score\")\n","plt.title(\"GMM Model Selection using AIC and BIC\")\n","plt.legend()\n","plt.grid(True)\n","plt.tight_layout()\n","\n","plt.savefig(\n","    f\"{OUTPUT_DIR}/aic_bic_comparison.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 10. TRAIN FINAL GMM\n","# ============================================================\n","\n","best_gmm = GaussianMixture(\n","    n_components=best_components_aic, # Changed to use AIC for more clusters\n","    covariance_type=\"full\",\n","    random_state=RANDOM_STATE,\n","    n_init=20,\n","    max_iter=500\n",")\n","\n","best_gmm.fit(X_scaled)\n","\n","print(\"Final GMM trained successfully.\")\n","\n","print(\"\\nConverged:\", best_gmm.converged_)\n","print(\"Iterations:\", best_gmm.n_iter_)\n","\n","\n","# ============================================================\n","# 11. HARD CLUSTER ASSIGNMENT\n","# ============================================================\n","\n","cluster_labels = best_gmm.predict(X_scaled)\n","\n","customer_df[\"Cluster\"] = cluster_labels\n","\n","print(\"\\nCluster distribution:\")\n","print(\n","    customer_df[\"Cluster\"]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","\n","# ============================================================\n","# 12. SOFT CLUSTER ASSIGNMENT\n","# ============================================================\n","\n","probabilities = best_gmm.predict_proba(X_scaled)\n","\n","for i in range(best_components_aic): # Changed to use AIC for more clusters\n","    customer_df[\n","        f\"Cluster_{i}_Probability\"\n","    ] = probabilities[:, i]\n","\n","customer_df[\"Cluster_Confidence\"] = (\n","    probabilities.max(axis=1)\n",")\n","\n","print(\"\\nExample cluster probabilities:\")\n","display(\n","    customer_df[\n","        [\n","            \"Customer_ID\",\n","            \"Cluster\",\n","            \"Cluster_Confidence\"\n","        ]\n","    ].head(10)\n",")\n","\n","\n","# ============================================================\n","# 13. PCA FOR VISUALIZATION\n","# ============================================================\n","\n","pca = PCA(\n","    n_components=2,\n","    random_state=RANDOM_STATE\n",")\n","\n","X_pca = pca.fit_transform(X_scaled)\n","\n","customer_df[\"PCA_1\"] = X_pca[:, 0]\n","customer_df[\"PCA_2\"] = X_pca[:, 1]\n","\n","print(\n","    \"PCA explained variance:\",\n","    pca.explained_variance_ratio_\n",")\n","\n","print(\n","    \"Total explained variance:\",\n","    pca.explained_variance_ratio_.sum()\n",")\n","\n","\n","# ============================================================\n","# 14. VISUALIZE CUSTOMER CLUSTERS\n","# ============================================================\n","\n","plt.figure(figsize=(12, 8))\n","\n","scatter = plt.scatter(\n","    customer_df[\"PCA_1\"],\n","    customer_df[\"PCA_2\"],\n","    c=customer_df[\"Cluster\"],\n","    alpha=0.7\n",")\n","\n","plt.xlabel(\"Principal Component 1\")\n","plt.ylabel(\"Principal Component 2\")\n","plt.title(\n","    \"Customer Segmentation using Gaussian Mixture Model\"\n",")\n","\n","plt.colorbar(\n","    scatter,\n","    label=\"Cluster\"\n",")\n","\n","plt.grid(True)\n","plt.tight_layout()\n","\n","plt.savefig(\n","    f\"{OUTPUT_DIR}/gmm_customer_clusters.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 15. VISUALIZE CLUSTER CONFIDENCE\n","# ============================================================\n","\n","plt.figure(figsize=(12, 8))\n","\n","scatter = plt.scatter(\n","    customer_df[\"PCA_1\"],\n","    customer_df[\"PCA_2\"],\n","    c=customer_df[\"Cluster_Confidence\"],\n","    alpha=0.7\n",")\n","\n","plt.xlabel(\"Principal Component 1\")\n","plt.ylabel(\"Principal Component 2\")\n","plt.title(\"GMM Cluster Assignment Confidence\")\n","\n","plt.colorbar(\n","    scatter,\n","    label=\"Cluster Confidence\"\n",")\n","\n","plt.grid(True)\n","plt.tight_layout()\n","\n","plt.savefig(\n","    f\"{OUTPUT_DIR}/cluster_confidence.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 16. CLUSTER PROFILE\n","# ============================================================\n","\n","cluster_profile = customer_df.groupby(\n","    \"Cluster\"\n",")[features].mean()\n","\n","print(\"\\nCluster Profile:\")\n","display(cluster_profile)\n","\n","cluster_profile.to_csv(\n","    f\"{OUTPUT_DIR}/cluster_profile.csv\"\n",")\n","\n","\n","# ============================================================\n","# 17. CLUSTER SIZE\n","# ============================================================\n","\n","cluster_size = (\n","    customer_df[\"Cluster\"]\n","    .value_counts()\n","    .sort_index()\n","    .reset_index()\n",")\n","\n","cluster_size.columns = [\n","    \"Cluster\",\n","    \"Customer_Count\"\n","]\n","\n","cluster_size[\"Percentage\"] = (\n","    cluster_size[\"Customer_Count\"]\n","    / len(customer_df)\n","    * 100\n",")\n","\n","display(cluster_size)\n","\n","cluster_size.to_csv(\n","    f\"{OUTPUT_DIR}/cluster_size.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 18. GMM COVARIANCE ANALYSIS\n","# ============================================================\n","\n","covariance_matrices = []\n","\n","for cluster_id, covariance in enumerate(\n","    best_gmm.covariances_\n","):\n","\n","    covariance_df = pd.DataFrame(\n","        covariance,\n","        index=features,\n","        columns=features\n","    )\n","\n","    covariance_df.to_csv(\n","        f\"{OUTPUT_DIR}/covariance_cluster_{cluster_id}.csv\"\n","    )\n","\n","    covariance_matrices.append(\n","        covariance_df\n","    )\n","\n","print(\"Covariance matrices saved.\")\n","\n","\n","# ============================================================\n","# 19. MODEL QUALITY METRICS\n","# ============================================================\n","\n","silhouette = silhouette_score(\n","    X_scaled,\n","    cluster_labels\n",")\n","\n","calinski = calinski_harabasz_score(\n","    X_scaled,\n","    cluster_labels\n",")\n","\n","davies = davies_bouldin_score(\n","    X_scaled,\n","    cluster_labels\n",")\n","\n","model_metrics = pd.DataFrame({\n","    \"Metric\": [\n","        \"Silhouette Score\",\n","        \"Calinski-Harabasz Score\",\n","        \"Davies-Bouldin Score\",\n","        \"BIC\",\n","        \"AIC\",\n","        \"Log Likelihood\",\n","        \"Number of Components\"\n","    ],\n","    \"Value\": [\n","        silhouette,\n","        calinski,\n","        davies,\n","        best_gmm.bic(X_scaled),\n","        best_gmm.aic(X_scaled),\n","        best_gmm.score(X_scaled),\n","        best_components_aic # Changed to reflect the new chosen components\n","    ]\n","})\n","\n","print(\"\\nGMM Model Metrics:\")\n","display(model_metrics)\n","\n","model_metrics.to_csv(\n","    f\"{OUTPUT_DIR}/gmm_metrics.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 20. CLUSTER CONFIDENCE ANALYSIS\n","# ============================================================\n","\n","confidence_summary = pd.DataFrame({\n","    \"Statistic\": [\n","        \"Mean Confidence\",\n","        \"Median Confidence\",\n","        \"Minimum Confidence\",\n","        \"Maximum Confidence\"\n","    ],\n","    \"Value\": [\n","        customer_df[\"Cluster_Confidence\"].mean(),\n","        customer_df[\"Cluster_Confidence\"].median(),\n","        customer_df[\"Cluster_Confidence\"].min(),\n","        customer_df[\"Cluster_Confidence\"].max()\n","    ]\n","})\n","\n","display(confidence_summary)\n","\n","confidence_summary.to_csv(\n","    f\"{OUTPUT_DIR}/confidence_summary.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 21. LOW-CONFIDENCE CUSTOMERS\n","# ============================================================\n","\n","low_confidence_customers = customer_df.sort_values(\n","    by=\"Cluster_Confidence\"\n",").head(30)\n","\n","print(\"\\nCustomers with lowest cluster confidence:\")\n","\n","display(\n","    low_confidence_customers[\n","        [\n","            \"Customer_ID\",\n","            \"Cluster\",\n","            \"Cluster_Confidence\"\n","        ] + features\n","    ]\n",")\n","\n","low_confidence_customers.to_csv(\n","    f\"{OUTPUT_DIR}/low_confidence_customers.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 22. CLUSTER VISUALIZATION - INCOME VS PURCHASE FREQUENCY\n","# ============================================================\n","\n","plt.figure(figsize=(12, 8))\n","\n","scatter = plt.scatter(\n","    customer_df[\"Annual_Income\"],\n","    customer_df[\"Purchase_Frequency\"],\n","    c=customer_df[\"Cluster\"],\n","    alpha=0.7\n",")\n","\n","plt.xlabel(\"Annual Income\")\n","plt.ylabel(\"Purchase Frequency\")\n","plt.title(\n","    \"Customer Segments: Income vs Purchase Frequency\"\n",")\n","\n","plt.colorbar(\n","    scatter,\n","    label=\"Cluster\"\n",")\n","\n","plt.grid(True)\n","plt.tight_layout()\n","\n","plt.savefig(\n","    f\"{OUTPUT_DIR}/income_vs_purchase_frequency.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 23. CLUSTER VISUALIZATION - ORDER VALUE VS WEBSITE VISITS\n","# ============================================================\n","\n","plt.figure(figsize=(12, 8))\n","\n","scatter = plt.scatter(\n","    customer_df[\"Average_Order_Value\"],\n","    customer_df[\"Website_Visits\"],\n","    c=customer_df[\"Cluster\"],\n","    alpha=0.7\n",")\n","\n","plt.xlabel(\"Average Order Value\")\n","plt.ylabel(\"Website Visits\")\n","plt.title(\n","    \"Customer Segments: Order Value vs Website Visits\"\n",")\n","\n","plt.colorbar(\n","    scatter,\n","    label=\"Cluster\"\n",")\n","\n","plt.grid(True)\n","plt.tight_layout()\n","\n","plt.savefig(\n","    f\"{OUTPUT_DIR}/order_value_vs_website_visits.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 24. CUSTOMER SEGMENT LABELS\n","# ============================================================\n","\n","# Create labels based on cluster profile.\n","# The labels are descriptive rather than model-generated.\n","\n","profile_for_labeling = cluster_profile.copy()\n","\n","income_median = (\n","    profile_for_labeling[\"Annual_Income\"].median()\n",")\n","\n","purchase_median = (\n","    profile_for_labeling[\"Purchase_Frequency\"].median()\n",")\n","\n","segment_names = {}\n","\n","for cluster_id, row in profile_for_labeling.iterrows():\n","\n","    if (n_components==1):\n","        segment_names[cluster_id] = \"All Customers\" # Assign a generic label if only one cluster is found\n","    elif (\n","        row[\"Annual_Income\"] >= income_median\n","        and row[\"Purchase_Frequency\"] >= purchase_median\n","    ):\n","        segment_names[cluster_id] = \"High Value Customers\"\n","\n","    elif (\n","        row[\"Annual_Income\"] >= income_median\n","        and row[\"Purchase_Frequency\"] < purchase_median\n","    ):\n","        segment_names[cluster_id] = \"Premium Occasional Customers\"\n","\n","    elif (\n","        row[\"Annual_Income\"] < income_median\n","        and row[\"Purchase_Frequency\"] >= purchase_median\n","    ):\n","        segment_names[cluster_id] = \"Frequent Budget Customers\"\n","\n","    else:\n","        segment_names[cluster_id] = \"Low Engagement Customers\"\n","\n","customer_df[\"Segment\"] = (\n","    customer_df[\"Cluster\"]\n","    .map(segment_names)\n",")\n","\n","print(\"\\nSegment mapping:\")\n","print(segment_names)\n","\n","\n","# ============================================================\n","# 25. FINAL CUSTOMER SEGMENT TABLE\n","# ============================================================\n","\n","final_customer_data = customer_df[\n","    [\n","        \"Customer_ID\",\n","        \"Age\",\n","        \"Annual_Income\",\n","        \"Purchase_Frequency\",\n","        \"Average_Order_Value\",\n","        \"Website_Visits\",\n","        \"Discount_Usage\",\n","        \"Cluster\",\n","        \"Segment\",\n","        \"Cluster_Confidence\"\n","    ]\n","]\n","\n","display(final_customer_data.head(20))\n","\n","final_customer_data.to_csv(\n","    f\"{OUTPUT_DIR}/final_customer_segments.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 26. SAVE SCALER\n","# ============================================================\n","\n","joblib.dump(\n","    scaler,\n","    f\"{OUTPUT_DIR}/customer_scaler.pkl\"\n",")\n","\n","\n","# ============================================================\n","# 27. SAVE PCA MODEL\n","# ============================================================\n","\n","joblib.dump(\n","    pca,\n","    f\"{OUTPUT_DIR}/customer_pca.pkl\"\n",")\n","\n","\n","# ============================================================\n","# 28. SAVE GMM MODEL\n","# ============================================================\n","\n","joblib.dump(\n","    best_gmm,\n","    f\"{OUTPUT_DIR}/gmm_customer_segmentation_model.pkl\"\n",")\n","\n","print(\"GMM model saved successfully.\")\n","\n","\n","# ============================================================\n","# 29. LOAD SAVED MODEL\n","# ============================================================\n","\n","loaded_gmm = joblib.load(\n","    f\"{OUTPUT_DIR}/gmm_customer_segmentation_model.pkl\"\n",")\n","\n","loaded_scaler = joblib.load(\n","    f\"{OUTPUT_DIR}/customer_scaler.pkl\"\n",")\n","\n","\n","# ============================================================\n","# 30. CUSTOM CUSTOMER PREDICTION\n","# ============================================================\n","\n","new_customer = pd.DataFrame({\n","    \"Age\": [29],\n","    \"Annual_Income\": [72000],\n","    \"Purchase_Frequency\": [18],\n","    \"Average_Order_Value\": [95],\n","    \"Website_Visits\": [60],\n","    \"Discount_Usage\": [25]\n","})\n","\n","new_customer_scaled = loaded_scaler.transform(\n","    new_customer[features]\n",")\n","\n","new_cluster = loaded_gmm.predict(\n","    new_customer_scaled\n",")[0]\n","\n","new_probabilities = loaded_gmm.predict_proba(\n","    new_customer_scaled\n",")[0]\n","\n","new_confidence = new_probabilities.max()\n","\n","new_segment = segment_names.get(\n","    int(new_cluster),\n","    \"Unknown Segment\"\n",")\n","\n","print(\"\\nCUSTOMER PREDICTION\")\n","print(\"=\" * 45)\n","\n","print(\"Predicted Cluster:\", new_cluster)\n","print(\"Predicted Segment:\", new_segment)\n","print(\n","    f\"Cluster Confidence: {new_confidence:.4f}\"\n",")\n","\n","print(\"\\nCluster Probabilities:\")\n","\n","for cluster_id, probability in enumerate(\n","    new_probabilities\n","):\n","    print(\n","        f\"Cluster {cluster_id}: \"\n","        f\"{probability:.4f}\"\n","    )\n","\n","\n","# ============================================================\n","# 31. FINAL OUTPUT LIST\n","# ============================================================\n","\n","print(\"\\n\" + \"=\" * 60)\n","print(\"DAY 25 - GMM CUSTOMER SEGMENTATION COMPLETED\")\n","print(\"=\" * 60)\n","\n","print(\"\\nModel:\")\n","print(\"Gaussian Mixture Model\")\n","\n","print(\"\\nComponents:\", best_components_aic) # Changed to reflect the new chosen components\n","\n","print(\"\\nSilhouette Score:\",\n","      round(silhouette, 4))\n","\n","print(\"\\nAIC:\",\n","      round(best_gmm.aic(X_scaled), 2))\n","\n","print(\"\\nBIC:\",\n","      round(best_gmm.bic(X_scaled), 2))\n","\n","print(\"\\nTop Cluster Profile:\")\n","display(cluster_profile)\n","\n","print(\"\\nGenerated Files:\")\n","\n","for file in sorted(os.listdir(OUTPUT_DIR)):\n","    print(\"-\", file)"]}]}
new_house[\"AveRooms\"]\n","    )\n","\n","    prediction = best_model.predict(\n","        new_house\n","    )[0]\n","\n","    return prediction\n","\n","\n","# ============================================================\n","# 39. TEST CUSTOM PREDICTION\n","# ============================================================\n","\n","custom_prediction = predict_house(\n","    MedInc=5.0,\n","    HouseAge=20,\n","    AveRooms=6.0,\n","    AveBedrms=1.0,\n","    Population=1000,\n","    AveOccup=3.0,\n","    Latitude=34.0,\n","    Longitude=-118.0\n",")\n","\n","print(\n","    \"\\n========== CUSTOM HOUSE PREDICTION ==========\"\n",")\n","\n","print(\n","    f\"Predicted House Value: \"\n","    f\"${custom_prediction * 100000:,.2f}\"\n",")\n","\n","\n","# ============================================================\n","# 40. FINAL SUMMARY\n","# ============================================================\n","\n","print(\"\\n==============================================\")\n","print(\"DAY 21 ADVANCED PROJECT COMPLETED\")\n","print(\"Random Forest Regression\")\n","print(\"==============================================\")\n","\n","print(\n","    f\"CV RMSE   : {-random_search.best_score_:.4f}\"\n",")\n","\n","print(\n","    f\"Test MAE  : {test_mae:.4f}\"\n",")\n","\n","print(\n","    f\"Test RMSE : {test_rmse:.4f}\"\n",")\n","\n","print(\n","    f\"Test R²   : {test_r2:.4f}\"\n",")\n","\n","print(\"\\nGenerated Files:\")\n","\n","for file in os.listdir(OUTPUT_DIR):\n","    print(\"-\", file)"]}]}
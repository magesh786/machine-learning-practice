===========================================================\n","\n","print(\"\\nDataset Information:\")\n","print(df.info())\n","\n","print(\"\\nStatistical Summary:\")\n","print(df.describe())\n","\n","# ============================================================\n","# 5. Check Missing Values\n","# ============================================================\n","\n","print(\"\\nMissing Values:\")\n","print(df.isnull().sum())\n","\n","# ============================================================\n","# 6. Correlation Matrix\n","# ============================================================\n","\n","plt.figure(figsize=(10, 7))\n","\n","sns.heatmap(\n","    df.corr(),\n","    annot=True,\n","    fmt=\".2f\",\n","    cmap=\"coolwarm\"\n",")\n","\n","plt.title(\"California Housing Correlation Matrix\")\n","plt.show()\n","\n","# ============================================================\n","# 7. Train-Test Split\n","# ============================================================\n","\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X,\n","    y,\n","    test_size=0.20,\n","    random_state=42\n",")\n","\n","print(\"\\nTraining Samples:\", len(X_train))\n","print(\"Testing Samples:\", len(X_test))\n","\n","# ============================================================\n","# 8. Feature Scaling\n","# ============================================================\n","\n","scaler = StandardScaler()\n","\n","X_train_scaled = scaler.fit_transform(X_train)\n","X_test_scaled = scaler.transform(X_test)\n","\n","print(\"\\nFeature scaling completed.\")\n","\n","# ============================================================\n","# 9. Train KNN Regression Model\n","# ============================================================\n","\n","model = KNeighborsRegressor(\n","    n_neighbors=5,\n","    weights=\"distance\",\n","    metric=\"minkowski\",\n","    p=2\n",")\n","\n","print(\"\\nKNN Configuration:\")\n","print(\"Number of Neighbors:\", 5)\n","print(\"Weights:\", \"distance\")\n","print(\"Distance Metric:\", \"Minkowski\")\n","print(\"p:\", 2)\n","\n","# ============================================================\n","# 10. Train Model\n","# ============================================================\n","\n","print(\"\\nTraining KNN Regression model...\")\n","\n","model.fit(\n","    X_train_scaled,\n","    y_train\n",")\n","\n","print(\"Training completed.\")\n","\n","# ============================================================\n","# 11. Predictions\n","# ============================================================\n","\n","y_pred = model.predict(\n","    X_test_scaled\n",")\n","\n","# ============================================================\n","# 12. Evaluation Metrics\n","# ============================================================\n","\n","mae = mean_absolute_error(\n","    y_test,\n","    y_pred\n",")\n","\n","mse = mean_squared_error(\n","    y_test,\n","    y_pred\n",")\n","\n","rmse = np.sqrt(mse)\n","\n","r2 = r2_score(\n","    y_test,\n","    y_pred\n",")\n","\n","print(\"\\n======================================\")\n","print(\"KNN REGRESSION PERFORMANCE\")\n","print(\"======================================\")\n","\n","print(\"MAE :\", round(mae, 4))\n","print(\"MSE :\", round(mse, 4))\n","print(\"RMSE:\", round(rmse, 4))\n","print(\"R²  :\", round(r2, 4))\n","\n","# ============================================================\n","# 13. Actual vs Predicted Results\n","# ============================================================\n","\n","results_df = pd.DataFrame({\n","    \"Actual_House_Value\": y_test,\n","    \"Predicted_House_Value\": y_pred\n","})\n","\n","print(\"\\nActual vs Predicted:\")\n","print(results_df.head(10))\n","\n","# ============================================================\n","# 14. Actual vs Predicted Plot\n","# ============================================================\n","\n","plt.figure(figsize=(8, 6))\n","\n","plt.scatter(\n","    y_test,\n","    y_pred,\n","    alpha=0.5\n",")\n","\n","minimum = min(\n","    y_test.min(),\n","    y_pred.min()\n",")\n","\n","maximum = max(\n","    y_test.max(),\n","    y_pred.max()\n",")\n","\n","plt.plot(\n","    [minimum, maximum],\n","    [minimum, maximum],\n","    linestyle=\"--\"\n",")\n","\n","plt.xlabel(\"Actual House Value\")\n","plt.ylabel(\"Predicted House Value\")\n","plt.title(\"KNN Regression - Actual vs Predicted\")\n","\n","plt.show()\n","\n","# ============================================================\n","# 15. Prediction Error\n","# ============================================================\n","\n","errors = y_test - y_pred\n","\n","plt.figure(figsize=(8, 6))\n","\n","plt.hist(\n","    errors,\n","    bins=30\n",")\n","\n","plt.xlabel(\"Prediction Error\")\n","plt.ylabel(\"Frequency\")\n","plt.title(\"KNN Regression Error Distribution\")\n","\n","plt.show()\n","\n","# ============================================================\n","# 16. Test Different K Values\n","# ============================================================\n","\n","k_values = [1, 3, 5, 7, 10, 15, 20]\n","\n","experiment_results = []\n","\n","for k in k_values:\n","\n","    knn = KNeighborsRegressor(\n","        n_neighbors=k,\n","        weights=\"distance\",\n","        metric=\"minkowski\",\n","        p=2\n","    )\n","\n","    knn.fit(\n","        X_train_scaled,\n","        y_train\n","    )\n","\n","    predictions = knn.predict(\n","        X_test_scaled\n","    )\n","\n","    experiment_mae = mean_absolute_error(\n","        y_test,\n","        predictions\n","    )\n","\n","    experiment_rmse = np.sqrt(\n","        mean_squared_error(\n","            y_test,\n","            predictions\n","        )\n","    )\n","\n","    experiment_r2 = r2_score(\n","        y_test,\n","        predictions\n","    )\n","\n","    experiment_results.append({\n","        \"K\": k,\n","        \"MAE\": experiment_mae,\n","        \"RMSE\": experiment_rmse,\n","        \"R2\": experiment_r2\n","    })\n","\n","experiment_df = pd.DataFrame(\n","    experiment_results\n",")\n","\n","print(\"\\nK Value Experiment:\")\n","print(experiment_df)\n","\n","# ============================================================\n","# 17. Visualize K Value Experiment\n","# ============================================================\n","\n","plt.figure(figsize=(8, 5))\n","\n","plt.plot(\n","    experiment_df[\"K\"],\n","    experiment_df[\"RMSE\"],\n","    marker=\"o\"\n",")\n","\n","plt.xlabel(\"Number of Neighbors (K)\")\n","plt.ylabel(\"RMSE\")\n","plt.title(\"KNN Hyperparameter Experiment\")\n","\n","plt.show()\n","\n","# ============================================================\n","# 18. Find Best K Based on RMSE\n","# ============================================================\n","\n","best_row = experiment_df.loc[\n","    experiment_df[\"RMSE\"].idxmin()\n","]\n","\n","best_k = int(\n","    best_row[\"K\"]\n",")\n","\n","print(\"\\nBest K based on RMSE:\", best_k)\n","\n","# ============================================================\n","# 19. Train Best K Model\n","# ============================================================\n","\n","best_model = KNeighborsRegressor(\n","    n_neighbors=best_k,\n","    weights=\"distance\",\n","    metric=\"minkowski\",\n","    p=2\n",")\n","\n","best_model.fit(\n","    X_train_scaled,\n","    y_train\n",")\n","\n","best_predictions = best_model.predict(\n","    X_test_scaled\n",")\n","\n","best_mae = mean_absolute_error(\n","    y_test,\n","    best_predictions\n",")\n","\n","best_rmse = np.sqrt(\n","    mean_squared_error(\n","        y_test,\n","        best_predictions\n","    )\n",")\n","\n","best_r2 = r2_score(\n","    y_test,\n","    best_predictions\n",")\n","\n","print(\"\\n======================================\")\n","print(\"BEST KNN MODEL\")\n","print(\"======================================\")\n","\n","print(\"Best K:\", best_k)\n","print(\"MAE :\", round(best_mae, 4))\n","print(\"RMSE:\", round(best_rmse, 4))\n","print(\"R²  :\", round(best_r2, 4))\n","\n","# ============================================================\n","# 20. Custom House Prediction\n","# ============================================================\n","\n","def predict_house_value(\n","    medinc,\n","    houseage,\n","    averooms,\n","    avebedrms,\n","    population,\n","    aveoccup,\n","    latitude,\n","    longitude\n","):\n","\n","    sample = np.array([\n","        medinc,\n","        houseage,\n","        averooms,\n","        avebedrms,\n","        population,\n","        aveoccup,\n","        latitude,\n","        longitude\n","    ]).reshape(1, -1)\n","\n","    sample_scaled = scaler.transform(\n","        sample\n","    )\n","\n","    prediction = best_model.predict(\n","        sample_scaled\n","    )\n","\n","    print(\"\\nPredicted House Value:\")\n","    print(\n","        round(prediction[0], 4),\n","        \"($100,000 units)\"\n","    )\n","\n","\n","# Example\n","predict_house_value(\n","    5.0,\n","    20.0,\n","    6.0,\n","    1.0,\n","    1500,\n","    3.0,\n","    34.0,\n","    -118.0\n",")\n","\n","# ============================================================\n","# 21. Save Prediction Results\n","# ============================================================\n","\n","best_results_df = pd.DataFrame({\n","    \"Actual_House_Value\": y_test,\n","    \"Predicted_House_Value\": best_predictions,\n","    \"Error\": y_test - best_predictions,\n","    \"Absolute_Error\": np.abs(\n","        y_test - best_predictions\n","    )\n","})\n","\n","best_results_df.to_csv(\n","    \"knn_house_predictions.csv\",\n","    index=False\n",")\n","\n","# ============================================================\n","# 22. Save K Experiment\n","# ============================================================\n","\n","experiment_df.to_csv(\n","    \"knn_k_experiment.csv\",\n","    index=False\n",")\n","\n","# ============================================================\n","# 23. Save Model Summary\n","# ============================================================\n","\n","model_summary = pd.DataFrame({\n","    \"Model\": [\"KNN Regressor\"],\n","    \"Best_K\": [best_k],\n","    \"Weights\": [\"distance\"],\n","    \"Metric\": [\"Minkowski\"],\n","    \"P\": [2],\n","    \"Training_Samples\": [len(X_train)],\n","    \"Testing_Samples\": [len(X_test)],\n","    \"Features\": [X.shape[1]],\n","    \"MAE\": [best_mae],\n","    \"RMSE\": [best_rmse],\n","    \"R2_Score\": [best_r2]\n","})\n","\n","model_summary.to_csv(\n","    \"knn_model_summary.csv\",\n","    index=False\n",")\n","\n","# ============================================================\n","# 24. Final Output\n","# ============================================================\n","\n","print(\"\\n======================================\")\n","print(\"FILES SAVED SUCCESSFULLY\")\n","print(\"======================================\")\n","\n","print(\"1. knn_house_predictions.csv\")\n","print(\"2. knn_k_experiment.csv\")\n","print(\"3. knn_model_summary.csv\")\n","\n","print(\"\\n🚀 Day 17 completed successfully!\")"]}]}
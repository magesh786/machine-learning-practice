px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\n","        fill: #174EA6;\n","      }\n","\n","      [theme=dark] .colab-df-generate {\n","        background-color: #3B4455;\n","        fill: #D2E3FC;\n","      }\n","\n","      [theme=dark] .colab-df-generate:hover {\n","        background-color: #434B5C;\n","        box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\n","        filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n","        fill: #FFFFFF;\n","      }\n","    </style>\n","    <button class=\"colab-df-generate\" onclick=\"generateWithVariable('model_summary')\"\n","            title=\"Generate code using this dataframe.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\"viewBox=\"0 0 24 24\"\n","       width=\"24px\">\n","    <path d=\"M7,19H8.4L18.45,9,17,7.55,7,17.6ZM5,21V16.75L18.45,3.32a2,2,0,0,1,2.83,0l1.4,1.43a1.91,1.91,0,0,1,.58,1.4,1.91,1.91,0,0,1-.58,1.4L9.25,21ZM18.45,9,17,7.55Zm-12,3A5.31,5.31,0,0,0,4.9,8.1,5.31,5.31,0,0,0,1,6.5,5.31,5.31,0,0,0,4.9,4.9,5.31,5.31,0,0,0,6.5,1,5.31,5.31,0,0,0,8.1,4.9,5.31,5.31,0,0,0,12,6.5,5.46,5.46,0,0,0,6.5,12Z\"/>\n","  </svg>\n","    </button>\n","    <script>\n","      (() => {\n","      const buttonEl =\n","        document.querySelector('#id_d97dac7c-d427-43d1-a19b-1c27f7d1a628 button.colab-df-generate');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      buttonEl.onclick = () => {\n","        google.colab.notebook.generateWithVariable('model_summary');\n","      }\n","      })();\n","    </script>\n","  </div>\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"model_summary","summary":"{\n  \"name\": \"model_summary\",\n  \"rows\": 9,\n  \"fields\": [\n    {\n      \"column\": \"Metric\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 9,\n        \"samples\": [\n          \"learning_rate\",\n          \"Learning Type\",\n          \"Base Estimator\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Value\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 9,\n        \"samples\": [\n          0.5,\n          \"Supervised Learning\",\n          \"Decision Tree\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Model summary saved!\n","\n","========================================\n","DAY 11 PROJECT COMPLETED!\n","========================================\n","Project: Breast Cancer Classification\n","Algorithm: AdaBoost\n","Learning Type: Supervised Learning\n","Number of Features: 30\n","Training Samples: 455\n","Testing Samples: 114\n","Number of Estimators: 100\n","Learning Rate: 0.5\n","Accuracy: 95.61 %\n","========================================\n"]}],"source":["# ============================================================\n","# DAY 11 - ADABOOST CLASSIFICATION\n","# Breast Cancer Dataset\n","# ============================================================\n","\n","# 1. IMPORT LIBRARIES\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","from sklearn.datasets import load_breast_cancer\n","from sklearn.model_selection import train_test_split\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.ensemble import AdaBoostClassifier\n","from sklearn.tree import DecisionTreeClassifier\n","\n","from sklearn.metrics import (\n","    accuracy_score,\n","    classification_report,\n","    confusion_matrix,\n","    ConfusionMatrixDisplay\n",")\n","\n","print(\"Libraries imported successfully!\")\n","\n","\n","# ============================================================\n","# 2. LOAD DATASET\n","# ============================================================\n","\n","cancer = load_breast_cancer()\n","\n","X = pd.DataFrame(\n","    cancer.data,\n","    columns=cancer.feature_names\n",")\n","\n","y = pd.Series(\n","    cancer.target,\n","    name=\"Target\"\n",")\n","\n","df = X.copy()\n","df[\"Target\"] = y\n","\n","print(\"\\nDataset loaded successfully!\")\n","print(\"Dataset Shape:\", df.shape)\n","\n","display(df.head())\n","\n","\n","# ============================================================\n","# 3. DATASET INFORMATION\n","# ============================================================\n","\n","print(\"\\nDataset Information:\")\n","df.info()\n","\n","print(\"\\nMissing Values:\")\n","print(df.isnull().sum())\n","\n","print(\"\\nStatistical Summary:\")\n","display(df.describe())\n","\n","\n","# ============================================================\n","# 4. TARGET INFORMATION\n","# ============================================================\n","\n","print(\"\\nTarget Distribution:\")\n","print(df[\"Target\"].value_counts())\n","\n","print(\"\\nTarget Classes:\")\n","\n","for i, name in enumerate(cancer.target_names):\n","    print(i, \"=\", name)\n","\n","\n","# ============================================================\n","# 5. TARGET VISUALIZATION\n","# ============================================================\n","\n","plt.figure(figsize=(8, 5))\n","\n","sns.countplot(\n","    data=df,\n","    x=\"Target\"\n",")\n","\n","plt.title(\"Breast Cancer Target Distribution\")\n","plt.xlabel(\"Target Class\")\n","plt.ylabel(\"Number of Samples\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 6. SEPARATE FEATURES AND TARGET\n","# ============================================================\n","\n","X = df.drop(\"Target\", axis=1)\n","y = df[\"Target\"]\n","\n","print(\"\\nNumber of Samples:\", X.shape[0])\n","print(\"Number of Features:\", X.shape[1])\n","\n","\n","# ============================================================\n","# 7. TRAIN TEST SPLIT\n","# ============================================================\n","\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X,\n","    y,\n","    test_size=0.20,\n","    random_state=42,\n","    stratify=y\n",")\n","\n","print(\"\\nTraining Samples:\", X_train.shape[0])\n","print(\"Testing Samples:\", X_test.shape[0])\n","\n","\n","# ============================================================\n","# 8. FEATURE SCALING\n","# ============================================================\n","\n","scaler = StandardScaler()\n","\n","X_train_scaled = scaler.fit_transform(X_train)\n","X_test_scaled = scaler.transform(X_test)\n","\n","print(\"\\nFeature scaling completed!\")\n","\n","\n","# ============================================================\n","# 9. CREATE BASE ESTIMATOR\n","# ============================================================\n","\n","base_model = DecisionTreeClassifier(\n","    max_depth=1,\n","    random_state=42\n",")\n","\n","print(\"\\nBase Decision Tree created!\")\n","\n","\n","# ============================================================\n","# 10. CREATE ADABOOST MODEL\n","# ============================================================\n","\n","model = AdaBoostClassifier(\n","    estimator=base_model,\n","    n_estimators=100,\n","    learning_rate=0.5,\n","    random_state=42\n",")\n","\n","print(\"\\nAdaBoost model created!\")\n","\n","print(model)\n","\n","\n","# ============================================================\n","# 11. TRAIN MODEL\n","# ============================================================\n","\n","model.fit(\n","    X_train_scaled,\n","    y_train\n",")\n","\n","print(\"\\nAdaBoost training completed!\")\n","\n","\n","# ============================================================\n","# 12. MAKE PREDICTIONS\n","# ============================================================\n","\n","y_pred = model.predict(\n","    X_test_scaled\n",")\n","\n","print(\"\\nPredictions completed!\")\n","\n","\n","# ============================================================\n","# 13. CALCULATE ACCURACY\n","# ============================================================\n","\n","accuracy = accuracy_score(\n","    y_test,\n","    y_pred\n",")\n","\n","print(\"\\nModel Accuracy:\")\n","print(round(accuracy * 100, 2), \"%\")\n","\n","\n","# ============================================================\n","# 14. CLASSIFICATION REPORT\n","# ============================================================\n","\n","print(\"\\nClassification Report:\")\n","\n","print(\n","    classification_report(\n","        y_test,\n","        y_pred,\n","        target_names=cancer.target_names\n","    )\n",")\n","\n","\n","# ============================================================\n","# 15. CONFUSION MATRIX\n","# ============================================================\n","\n","cm = confusion_matrix(\n","    y_test,\n","    y_pred\n",")\n","\n","print(\"\\nConfusion Matrix:\")\n","print(cm)\n","\n","\n","# ============================================================\n","# 16. CONFUSION MATRIX VISUALIZATION\n","# ============================================================\n","\n","disp = ConfusionMatrixDisplay(\n","    confusion_matrix=cm,\n","    display_labels=cancer.target_names\n",")\n","\n","disp.plot()\n","\n","plt.title(\"AdaBoost Confusion Matrix\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 17. FEATURE IMPORTANCE\n","# ============================================================\n","\n","feature_importance = pd.DataFrame({\n","    \"Feature\": X.columns,\n","    \"Importance\": model.feature_importances_\n","})\n","\n","feature_importance = feature_importance.sort_values(\n","    by=\"Importance\",\n","    ascending=False\n",")\n","\n","print(\"\\nTop Important Features:\")\n","\n","display(\n","    feature_importance.head(15)\n",")\n","\n","\n","# ============================================================\n","# 18. FEATURE IMPORTANCE VISUALIZATION\n","# ============================================================\n","\n","top_features = feature_importance.head(15)\n","\n","plt.figure(figsize=(10, 7))\n","\n","sns.barplot(\n","    data=top_features,\n","    x=\"Importance\",\n","    y=\"Feature\"\n",")\n","\n","plt.title(\n","    \"Top 15 Feature Importances - AdaBoost\"\n",")\n","\n","plt.xlabel(\"Importance\")\n","plt.ylabel(\"Feature\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 19. PREDICTION PROBABILITY\n","# ============================================================\n","\n","probabilities = model.predict_proba(\n","    X_test_scaled\n",")\n","\n","probability_df = pd.DataFrame(\n","    probabilities,\n","    columns=[\n","        \"Malignant_Probability\",\n","        \"Benign_Probability\"\n","    ]\n",")\n","\n","print(\"\\nPrediction Probabilities:\")\n","\n","display(\n","    probability_df.head(10)\n",")\n","\n","\n","# ============================================================\n","# 20. CREATE PREDICTION DATAFRAME\n","# ============================================================\n","\n","prediction_df = pd.DataFrame({\n","    \"Actual\": y_test.values,\n","    \"Predicted\": y_pred,\n","    \"Malignant_Probability\": probabilities[:, 0],\n","    \"Benign_Probability\": probabilities[:, 1]\n","})\n","\n","print(\"\\nPrediction Results:\")\n","\n","display(\n","    prediction_df.head(15)\n",")\n","\n","\n","# ============================================================\n","# 21. ACTUAL VS PREDICTED LABELS\n","# ============================================================\n","\n","prediction_df[\"Actual_Label\"] = prediction_df[\n","    \"Actual\"\n","].map({\n","    0: \"malignant\",\n","    1: \"benign\"\n","})\n","\n","prediction_df[\"Predicted_Label\"] = prediction_df[\n","    \"Predicted\"\n","].map({\n","    0: \"malignant\",\n","    1: \"benign\"\n","})\n","\n","print(\"\\nActual vs Predicted:\")\n","\n","display(\n","    prediction_df.head(20)\n",")\n","\n","\n","# ============================================================\n","# 22. MODEL PARAMETER EXPERIMENT\n","# ============================================================\n","\n","estimators = [10, 25, 50, 100, 150, 200]\n","\n","estimator_results = []\n","\n","for n in estimators:\n","\n","    temp_model = AdaBoostClassifier(\n","        estimator=base_model,\n","        n_estimators=n,\n","        learning_rate=0.5,\n","        random_state=42\n","    )\n","\n","    temp_model.fit(\n","        X_train_scaled,\n","        y_train\n","    )\n","\n","    temp_prediction = temp_model.predict(\n","        X_test_scaled\n","    )\n","\n","    temp_accuracy = accuracy_score(\n","        y_test,\n","        temp_prediction\n","    )\n","\n","    estimator_results.append({\n","        \"n_estimators\": n,\n","        \"accuracy\": temp_accuracy\n","    })\n","\n","\n","estimator_df = pd.DataFrame(\n","    estimator_results\n",")\n","\n","print(\"\\nEstimator Experiment:\")\n","\n","display(\n","    estimator_df\n",")\n","\n","\n","# ============================================================\n","# 23. ESTIMATOR VS ACCURACY GRAPH\n","# ============================================================\n","\n","plt.figure(figsize=(9, 6))\n","\n","plt.plot(\n","    estimator_df[\"n_estimators\"],\n","    estimator_df[\"accuracy\"],\n","    marker=\"o\"\n",")\n","\n","plt.title(\n","    \"AdaBoost: Number of Estimators vs Accuracy\"\n",")\n","\n","plt.xlabel(\"Number of Estimators\")\n","plt.ylabel(\"Accuracy\")\n","\n","plt.grid(True)\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 24. SAVE PREDICTIONS\n","# ============================================================\n","\n","prediction_df.to_csv(\n","    \"adaboost_breast_cancer_predictions.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"\\nPrediction result
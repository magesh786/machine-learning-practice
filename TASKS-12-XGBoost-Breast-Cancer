t(\"\\nMissing Values:\")\n","print(df.isnull().sum())\n","\n","print(\"\\nStatistical Summary:\")\n","display(df.describe())\n","\n","\n","# ============================================================\n","# 4. TARGET INFORMATION\n","# ============================================================\n","\n","print(\"\\nTarget Distribution:\")\n","print(df[\"Target\"].value_counts())\n","\n","print(\"\\nTarget Classes:\")\n","\n","for i, name in enumerate(cancer.target_names):\n","    print(i, \"=\", name)\n","\n","\n","# ============================================================\n","# 5. TARGET VISUALIZATION\n","# ============================================================\n","\n","plt.figure(figsize=(8, 5))\n","\n","sns.countplot(\n","    data=df,\n","    x=\"Target\"\n",")\n","\n","plt.title(\"Breast Cancer Target Distribution\")\n","plt.xlabel(\"Target Class\")\n","plt.ylabel(\"Number of Samples\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 6. SEPARATE FEATURES AND TARGET\n","# ============================================================\n","\n","X = df.drop(\"Target\", axis=1)\n","y = df[\"Target\"]\n","\n","print(\"\\nNumber of Samples:\", X.shape[0])\n","print(\"Number of Features:\", X.shape[1])\n","\n","\n","# ============================================================\n","# 7. TRAIN TEST SPLIT\n","# ============================================================\n","\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X,\n","    y,\n","    test_size=0.20,\n","    random_state=42,\n","    stratify=y\n",")\n","\n","print(\"\\nTraining Samples:\", X_train.shape[0])\n","print(\"Testing Samples:\", X_test.shape[0])\n","\n","\n","# ============================================================\n","# 8. FEATURE SCALING\n","# ============================================================\n","\n","scaler = StandardScaler()\n","\n","X_train_scaled = scaler.fit_transform(X_train)\n","X_test_scaled = scaler.transform(X_test)\n","\n","print(\"\\nFeature scaling completed!\")\n","\n","\n","# ============================================================\n","# 9. CREATE XGBOOST MODEL\n","# ============================================================\n","\n","model = XGBClassifier(\n","    n_estimators=100,\n","    learning_rate=0.1,\n","    max_depth=3,\n","    subsample=0.8,\n","    colsample_bytree=0.8,\n","    objective=\"binary:logistic\",\n","    eval_metric=\"logloss\",\n","    random_state=42,\n","    n_jobs=-1\n",")\n","\n","print(\"\\nXGBoost model created!\")\n","\n","print(model)\n","\n","\n","# ============================================================\n","# 10. TRAIN MODEL\n","# ============================================================\n","\n","model.fit(\n","    X_train_scaled,\n","    y_train\n",")\n","\n","print(\"\\nXGBoost training completed!\")\n","\n","\n","# ============================================================\n","# 11. MAKE PREDICTIONS\n","# ============================================================\n","\n","y_pred = model.predict(\n","    X_test_scaled\n",")\n","\n","print(\"\\nPredictions completed!\")\n","\n","\n","# ============================================================\n","# 12. PREDICTION PROBABILITY\n","# ============================================================\n","\n","y_probability = model.predict_proba(\n","    X_test_scaled\n",")[:, 1]\n","\n","print(\"\\nPrediction probabilities generated!\")\n","\n","\n","# ============================================================\n","# 13. ACCURACY\n","# ============================================================\n","\n","accuracy = accuracy_score(\n","    y_test,\n","    y_pred\n",")\n","\n","print(\"\\nModel Accuracy:\")\n","print(round(accuracy * 100, 2), \"%\")\n","\n","\n","# ============================================================\n","# 14. CLASSIFICATION REPORT\n","# ============================================================\n","\n","print(\"\\nClassification Report:\")\n","\n","print(\n","    classification_report(\n","        y_test,\n","        y_pred,\n","        target_names=cancer.target_names\n","    )\n",")\n","\n","\n","# ============================================================\n","# 15. CONFUSION MATRIX\n","# ============================================================\n","\n","cm = confusion_matrix(\n","    y_test,\n","    y_pred\n",")\n","\n","print(\"\\nConfusion Matrix:\")\n","print(cm)\n","\n","\n","# ============================================================\n","# 16. CONFUSION MATRIX VISUALIZATION\n","# ============================================================\n","\n","disp = ConfusionMatrixDisplay(\n","    confusion_matrix=cm,\n","    display_labels=cancer.target_names\n",")\n","\n","disp.plot()\n","\n","plt.title(\"XGBoost Confusion Matrix\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 17. FEATURE IMPORTANCE\n","# ============================================================\n","\n","feature_importance = pd.DataFrame({\n","    \"Feature\": X.columns,\n","    \"Importance\": model.feature_importances_\n","})\n","\n","feature_importance = feature_importance.sort_values(\n","    by=\"Importance\",\n","    ascending=False\n",")\n","\n","print(\"\\nTop 15 Important Features:\")\n","\n","display(\n","    feature_importance.head(15)\n",")\n","\n","\n","# ============================================================\n","# 18. FEATURE IMPORTANCE VISUALIZATION\n","# ============================================================\n","\n","top_features = feature_importance.head(15)\n","\n","plt.figure(figsize=(10, 7))\n","\n","sns.barplot(\n","    data=top_features,\n","    x=\"Importance\",\n","    y=\"Feature\"\n",")\n","\n","plt.title(\n","    \"Top 15 Feature Importances - XGBoost\"\n",")\n","\n","plt.xlabel(\"Importance\")\n","plt.ylabel(\"Feature\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 19. CREATE PREDICTION DATAFRAME\n","# ============================================================\n","\n","prediction_df = pd.DataFrame({\n","    \"Actual\": y_test.values,\n","    \"Predicted\": y_pred,\n","    \"Benign_Probability\": y_probability\n","})\n","\n","prediction_df[\"Actual_Label\"] = prediction_df[\n","    \"Actual\"\n","].map({\n","    0: \"malignant\",\n","    1: \"benign\"\n","})\n","\n","prediction_df[\"Predicted_Label\"] = prediction_df[\n","    \"Predicted\"\n","].map({\n","    0: \"malignant\",\n","    1: \"benign\"\n","})\n","\n","print(\"\\nPrediction Results:\")\n","\n","display(\n","    prediction_df.head(20)\n",")\n","\n","\n","# ============================================================\n","# 20. MODEL PARAMETER EXPERIMENT\n","# ============================================================\n","\n","estimators = [25, 50, 100, 150, 200]\n","\n","results = []\n","\n","for n in estimators:\n","\n","    temp_model = XGBClassifier(\n","        n_estimators=n,\n","        learning_rate=0.1,\n","        max_depth=3,\n","        subsample=0.8,\n","        colsample_bytree=0.8,\n","        objective=\"binary:logistic\",\n","        eval_metric=\"logloss\",\n","        random_state=42,\n","        n_jobs=-1\n","    )\n","\n","    temp_model.fit(\n","        X_train_scaled,\n","        y_train\n","    )\n","\n","    temp_pred = temp_model.predict(\n","        X_test_scaled\n","    )\n","\n","    temp_accuracy = accuracy_score(\n","        y_test,\n","        temp_pred\n","    )\n","\n","    results.append({\n","        \"n_estimators\": n,\n","        \"accuracy\": temp_accuracy\n","    })\n","\n","\n","experiment_df = pd.DataFrame(results)\n","\n","print(\"\\nXGBoost Estimator Experiment:\")\n","\n","display(\n","    experiment_df\n",")\n","\n","\n","# ============================================================\n","# 21. ESTIMATORS VS ACCURACY\n","# ============================================================\n","\n","plt.figure(figsize=(9, 6))\n","\n","plt.plot(\n","    experiment_df[\"n_estimators\"],\n","    experiment_df[\"accuracy\"],\n","    marker=\"o\"\n",")\n","\n","plt.title(\n","    \"XGBoost: Number of Estimators vs Accuracy\"\n",")\n","\n","plt.xlabel(\"Number of Estimators\")\n","plt.ylabel(\"Accuracy\")\n","\n","plt.grid(True)\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 22. SAVE PREDICTIONS\n","# ============================================================\n","\n","prediction_df.to_csv(\n","    \"xgboost_breast_cancer_predictions.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"\\nPrediction results saved as:\"\n",")\n","\n","print(\n","    \"xgboost_breast_cancer_predictions.csv\"\n",")\n","\n","\n","# ============================================================\n","# 23. SAVE FEATURE IMPORTANCE\n","# ============================================================\n","\n","feature_importance.to_csv(\n","    \"xgboost_feature_importance.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"\\nFeature importance saved as:\"\n",")\n","\n","print(\n","    \"xgboost_feature_importance.csv\"\n",")\n","\n","\n","# ============================================================\n","# 24. SAVE EXPERIMENT RESULTS\n","# ============================================================\n","\n","experiment_df.to_csv(\n","    \"xgboost_estimator_experiment.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"\\nExperiment results saved as:\"\n",")\n","\n","print(\n","    \"xgboost_estimator_experiment.csv\"\n",")\n","\n","\n","# ============================================================\n","# 25. MODEL SUMMARY\n","# ============================================================\n","\n","model_summary = pd.DataFrame({\n","    \"Metric\": [\n","        \"Algorithm\",\n","        \"Learning Type\",\n","        \"Training Samples\",\n","        \"Testing Samples\",\n","        \"Number of Features\",\n","        \"n_estimators\",\n"," 
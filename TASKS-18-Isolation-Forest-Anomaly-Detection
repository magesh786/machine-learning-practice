\": 11,\n        \"max\": 83,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          21,\n          83,\n          31\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Anomaly_Percentage\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 2.7781244219773855,\n        \"min\": 1.0679611650485437,\n        \"max\": 8.058252427184467,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          2.0388349514563107,\n          8.058252427184467,\n          3.0097087378640777\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Saved: isolation_forest_transactions.csv\n","Saved: detected_anomalies.csv\n","Saved: isolation_forest_experiment.csv\n","Saved: isolation_forest_model_summary.csv\n","\n","========== CUSTOM TRANSACTION ==========\n","Prediction: Anomaly\n","Anomaly Score: -0.1897\n","\n","========== NORMAL TRANSACTION ==========\n","Prediction: Normal\n","Anomaly Score: 0.1766\n","\n","============================================\n","DAY 18 PROJECT COMPLETED\n","Isolation Forest - Anomaly Detection\n","============================================\n","Total Transactions : 1030\n","Normal Transactions: 999\n","Anomalies Detected  : 31\n","Anomaly Percentage  : 3.01%\n","\n","Generated Files:\n","1. isolation_forest_transactions.csv\n","2. detected_anomalies.csv\n","3. isolation_forest_experiment.csv\n","4. isolation_forest_model_summary.csv\n"]}],"source":["# ============================================================\n","# DAY 18 - ISOLATION FOREST FOR ANOMALY DETECTION\n","# Machine Learning Daily Series\n","# ============================================================\n","\n","# =========================\n","# 1. Import Libraries\n","# =========================\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","from sklearn.ensemble import IsolationForest\n","from sklearn.preprocessing import StandardScaler\n","\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","\n","# =========================\n","# 2. Create Synthetic\n","#    Transaction Dataset\n","# =========================\n","\n","np.random.seed(42)\n","\n","normal_transactions = pd.DataFrame({\n","    \"Amount\": np.random.normal(1500, 500, 1000).clip(100, None),\n","    \"Transaction_Frequency\": np.random.normal(5, 2, 1000).clip(1, None),\n","    \"Transaction_Hour\": np.random.normal(14, 3, 1000).clip(0, 23),\n","    \"Distance_From_Home\": np.random.normal(10, 5, 1000).clip(0, None)\n","})\n","\n","# Create unusual transactions\n","anomalies = pd.DataFrame({\n","    \"Amount\": np.random.uniform(10000, 50000, 30),\n","    \"Transaction_Frequency\": np.random.uniform(15, 30, 30),\n","    \"Transaction_Hour\": np.random.uniform(0, 5, 30),\n","    \"Distance_From_Home\": np.random.uniform(100, 1000, 30)\n","})\n","\n","df = pd.concat(\n","    [normal_transactions, anomalies],\n","    ignore_index=True\n",")\n","\n","# Shuffle dataset\n","df = df.sample(\n","    frac=1,\n","    random_state=42\n",").reset_index(drop=True)\n","\n","print(\"Dataset Shape:\", df.shape)\n","\n","display(df.head())\n","\n","\n","# =========================\n","# 3. Dataset Information\n","# =========================\n","\n","print(\"\\nDataset Information:\")\n","df.info()\n","\n","print(\"\\nStatistical Summary:\")\n","display(df.describe())\n","\n","print(\"\\nMissing Values:\")\n","print(df.isnull().sum())\n","\n","\n","# =========================\n","# 4. Feature Selection\n","# =========================\n","\n","features = [\n","    \"Amount\",\n","    \"Transaction_Frequency\",\n","    \"Transaction_Hour\",\n","    \"Distance_From_Home\"\n","]\n","\n","X = df[features]\n","\n","print(\"\\nFeatures Used:\")\n","print(features)\n","\n","\n","# =========================\n","# 5. Feature Scaling\n","# =========================\n","\n","scaler = StandardScaler()\n","\n","X_scaled = scaler.fit_transform(X)\n","\n","print(\"\\nFeature scaling completed.\")\n","\n","\n","# =========================\n","# 6. Build Isolation Forest\n","# =========================\n","\n","model = IsolationForest(\n","    n_estimators=200,\n","    contamination=0.03,\n","    random_state=42,\n","    n_jobs=-1\n",")\n","\n","model.fit(X_scaled)\n","\n","print(\"\\nIsolation Forest model trained successfully!\")\n","\n","\n","# =========================\n","# 7. Predict Anomalies\n","# =========================\n","\n","predictions = model.predict(X_scaled)\n","\n","# Isolation Forest:\n","#  1  = Normal\n","# -1  = Anomaly\n","\n","df[\"Anomaly_Prediction\"] = predictions\n","\n","df[\"Anomaly_Label\"] = df[\n","    \"Anomaly_Prediction\"\n","].map({\n","    1: \"Normal\",\n","    -1: \"Anomaly\"\n","})\n","\n","\n","# =========================\n","# 8. Anomaly Score\n","# =========================\n","\n","df[\"Anomaly_Score\"] = model.decision_function(\n","    X_scaled\n",")\n","\n","print(\"\\nPrediction Results:\")\n","display(df.head(10))\n","\n","\n","# =========================\n","# 9. Count Anomalies\n","# =========================\n","\n","normal_count = (\n","    df[\"Anomaly_Label\"] == \"Normal\"\n",").sum()\n","\n","anomaly_count = (\n","    df[\"Anomaly_Label\"] == \"Anomaly\"\n",").sum()\n","\n","print(\"\\n========== ANOMALY SUMMARY ==========\")\n","print(\"Normal Transactions :\", normal_count)\n","print(\"Anomalous Transactions :\", anomaly_count)\n","\n","\n","# =========================\n","# 10. Anomaly Percentage\n","# =========================\n","\n","anomaly_percentage = (\n","    anomaly_count / len(df)\n",") * 100\n","\n","print(\n","    f\"Anomaly Percentage: \"\n","    f\"{anomaly_percentage:.2f}%\"\n",")\n","\n","\n","# =========================\n","# 11. Visualize Transaction\n","#     Amount vs Frequency\n","# =========================\n","\n","plt.figure(figsize=(10, 6))\n","\n","normal_data = df[\n","    df[\"Anomaly_Label\"] == \"Normal\"\n","]\n","\n","anomaly_data = df[\n","    df[\"Anomaly_Label\"] == \"Anomaly\"\n","]\n","\n","plt.scatter(\n","    normal_data[\"Amount\"],\n","    normal_data[\"Transaction_Frequency\"],\n","    alpha=0.5,\n","    label=\"Normal\"\n",")\n","\n","plt.scatter(\n","    anomaly_data[\"Amount\"],\n","    anomaly_data[\"Transaction_Frequency\"],\n","    alpha=0.8,\n","    label=\"Anomaly\"\n",")\n","\n","plt.xlabel(\"Transaction Amount\")\n","plt.ylabel(\"Transaction Frequency\")\n","plt.title(\"Isolation Forest - Transaction Anomaly Detection\")\n","plt.legend()\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================\n","# 12. Visualize Transaction\n","#     Hour vs Distance\n","# =========================\n","\n","plt.figure(figsize=(10, 6))\n","\n","plt.scatter(\n","    normal_data[\"Transaction_Hour\"],\n","    normal_data[\"Distance_From_Home\"],\n","    alpha=0.5,\n","    label=\"Normal\"\n",")\n","\n","plt.scatter(\n","    anomaly_data[\"Transaction_Hour\"],\n","    anomaly_data[\"Distance_From_Home\"],\n","    alpha=0.8,\n","    label=\"Anomaly\"\n",")\n","\n","plt.xlabel(\"Transaction Hour\")\n","plt.ylabel(\"Distance From Home\")\n","plt.title(\"Transaction Time vs Distance\")\n","plt.legend()\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================\n","# 13. Anomaly Score\n","#     Distribution\n","# =========================\n","\n","plt.figure(figsize=(10, 6))\n","\n","plt.hist(\n","    df[\"Anomaly_Score\"],\n","    bins=40\n",")\n","\n","plt.axvline(\n","    0,\n","    linestyle=\"--\",\n","    label=\"Anomaly Boundary\"\n",")\n","\n","plt.xlabel(\"Anomaly Score\")\n","plt.ylabel(\"Frequency\")\n","plt.title(\"Isolation Forest Anomaly Score Distribution\")\n","plt.legend()\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================\n","# 14. Sort by Most Anomalous\n","# =========================\n","\n","most_anomalous = df.sort_values(\n","    by=\"Anomaly_Score\"\n",").head(20)\n","\n","print(\"\\n========== TOP 20 MOST ANOMALOUS TRANSACTIONS ==========\")\n","\n","display(\n","    most_anomalous[\n","        features +\n","        [\n","            \"Anomaly_Score\",\n","            \"Anomaly_Label\"\n","        ]\n","    ]\n",")\n","\n","\n","# =========================\n","# 15. Feature Statistics\n","# =========================\n","\n","print(\"\\n========== NORMAL TRANSACTION STATISTICS ==========\")\n","\n","display(\n","    normal_data[features].describe()\n",")\n","\n","print(\"\\n========== ANOMALOUS TRANSACTION STATISTICS ==========\")\n","\n","display(\n","    anomaly_data[features].describe()\n",")\n","\n","\n","# =========================\n","# 16. Experiment with\n","#     Different Contamination\n","# =========================\n","\n","contamination_values = [\n","    0.01,\n","    0.02,\n","    0.03,\n","    0.05,\n","    0.08\n","]\n","\n","experiment_results = []\n","\n","for contamination in contamination_values:\n","\n","    experiment_model = IsolationForest(\n","        n_estimators=200,\n","        contamination=contamination,\n","        random_state=42,\n","        n_jobs=-1\n","    )\n","\n","    experiment_model.fit(X_scaled)\n","\n","    experiment_predictions = (\n","        experiment_model.predict(X_scaled)\n","    )\n","\n","    detected_anomalies = (\n","        experiment_predictions == -1\n","    ).sum()\n","\n","    experiment_results.append({\n","        \"Contamination\": contamination,\n","        \"Detected_Anomalies\": detected_anomalies,\n","        \"Anomaly_Percentage\":\n","            (detected_anomalies / len(df)) * 100\n","    })\n","\n","\n","contamination_results = pd.DataFrame(\n","    experiment_results\n",")\n","\n","print(\"\\n========== CONTAMINATION EXPERIMENT ==========\")\n","\n","display(contamination_results)\n","\n","\n","# =========================\n","# 17. Plot Contamination\n","# =========================\n","\n","plt.figure(figsize=(8, 5))\n","\n","plt.plot(\n","    contamination_results[\"Contamination\"],\n","    contamination_results[\"Detected_Anomalies\"],\n","    marker=\"o\"\n",")\n","\n","plt.xlabel(\"Contamination\")\n","plt.ylabel(\"Detected Anomalies\")\n","plt.title(\"Contamination vs Detected Anomalies\")\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================\n","# 18. Save Complete Results\n","# =========================\n","\n","df.to_csv(\n","    \"isolation_forest_transactions.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"\\nSaved: \"\n","    \"isolation_forest_transactions.csv\"\n",")\n","\n","\n","# =========================\n","# 19. Save Anomalies Only\n","# =========================\n","\n","anomaly_transactions = df[\n","    df[\"Anomaly_Label\"] == \"Anomaly\"\n","].copy()\n","\n","anomaly_transactions.to_csv(\n","    \"detected_anomalies.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"Saved: detected_anomalies.csv\"\n",")\n","\n","\n","# =========================\n","# 20. Save Experiment Results\n","# =========================\n","\n","contamination_results.to_csv(\n","    \"isolation_forest_experiment.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"Saved: isolation_forest_experiment.csv\"\n",")\n","\n","\n","# =========================\n","# 21. Save Model Summary\n","# =========================\n","\n","model_summary = pd.DataFrame({\n","    \"Parameter\": [\n","        \"Algorithm\",\n","        \"Number of Estimators\",\n","        \"Contamination\",\n","        \"Total Transactions\",\n","        \"Normal Transactions\",\n","        \"Detected Anomalies\",\n","        \"Anomaly Percentage\"\n","    ],\n","    \"Value\": [\n","        \"Isolation Forest\",\n","        200,\n","        0.03,\n","        len(df),\n","        normal_count,\n","        anomaly_count,\n","        anomaly_percentage\n","    ]\n","})\n","\n","model_summary.to_csv(\n","    \"isolation_forest_model_summary.csv\",\n","    index=False\n",")\n","\n","print(\n","    \"Saved: isolation_forest_model_summary.csv\"\n",")\n","\n","\n","# =========================\n","# 22. Custom Transaction\n","#     Anomaly Prediction\n","# =========================\n","\n","def check_transaction(\n","    amount,\n","    transaction_frequency,\n","    transaction_hour,\n","    distance_from_home\n","):\n","\n","    transaction = pd.DataFrame([{\n","        \"Amount\": amount,\n","        \"Transaction_Frequency\":\n","            transaction_frequency,\n","        \"Transaction_Hour\":\n","            transaction_hour,\n","        \"Distance_From_Home\":\n","            distance_from_home\n","    }])\n","\n","    transaction_scaled = scaler.transform(\n","        transaction\n","    )\n","\n","    prediction = model.predict(\n","        transaction_scaled\n","    )[0]\n","\n","    score = model.decision_function(\n","        transaction_scaled\n","    )[0]\n","\n","    if prediction == -1:\n","        result = \"Anomaly\"\n","    else:\n","        result = \"Normal\"\n","\n","    return result, score\n","\n","\n","# =========================\n","# 23. Test Custom Transaction\n","# =========================\n","\n","result, score = check_transaction(\n","    amount=25000,\n","    transaction_frequency=20,\n","    transaction_hour=2,\n","    distance_from_home=500\n",")\n","\n","print(\"\\n========== CUSTOM TRANSACTION ==========\")\n","print(\"Prediction:\", result)\n","print(\"Anomaly Score:\", round(score, 4))\n","\n","\n","# =========================\n","# 24. Test Normal Transaction\n","# =========================\n","\n","result_normal, score_normal = check_transaction(\n","    amount=1200,\n","    transaction_frequency=4,\n","    transaction_hour=14,\n","    distance_from_home=8\n",")\n","\n","print(\"\\n========== NORMAL TRANSACTION ==========\")\n","print(\"Prediction:\", result_normal)\n","print(\"Anomaly Score:\", round(score_normal, 4))\n","\n","\n","# =========================\n","# 25. Final Summary\n","# =========================\n","\n","print(\"\\n============================================\")\n","print(\"DAY 18 PROJECT COMPLETED\")\n","print(\"Isolation Forest - Anomaly Detection\")\n","print(\"============================================\")\n","\n","print(\"Total Transactions :\", len(df))\n","print(\"Normal Transactions:\", normal_count)\n","print(\"Anomalies Detected  :\", anomaly_count)\n","print(\n","    \"Anomaly Percentage  :\",\n","    f\"{anomaly_percentage:.2f}%\"\n",")\n","\n","print(\"\\nGenerated Files:\")\n","print(\"1. isolation_forest_transactions.csv\")\n","print(\"2. detected_anomalies.csv\")\n","print(\"3. isolation_forest_experiment.csv\")\n","print(\"4. isolation_forest_model_summary.csv\")"]}]}
olumn\": \"R2\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.04633086394480371,\n        \"min\": 0.5847571567499203,\n        \"max\": 0.6652770906967737,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          0.6652770906967737,\n          0.5848025043272123,\n          0.5847571567499203\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Model saved successfully.\n","\n","========== CUSTOM HOUSE PREDICTION ==========\n","Predicted House Value: $229,079.91\n","\n","==============================================\n","DAY 23 COMPLETED\n","ADVANCED ELASTIC NET REGRESSION\n","==============================================\n","Best Alpha: 0.005\n","Best L1 Ratio: 0.2\n","Test RMSE: 0.6744\n","Test R²: 0.6529\n","Selected Features: 13\n","Zero Coefficient Features: 2\n","\n","Generated files:\n","- elastic_net_coefficients.png\n","- elastic_net_model_summary.csv\n","- elastic_net_grid_search.csv\n","- residual_analysis.png\n","- elastic_net_alpha_experiment.csv\n","- l1_ratio_vs_rmse.png\n","- residual_distribution.png\n","- best_parameters.csv\n","- alpha_vs_rmse.png\n","- elastic_net_l1_ratio_experiment.csv\n","- l1_ratio_vs_features.png\n","- actual_vs_predicted.png\n","- learning_curve.png\n","- elastic_net_predictions.csv\n","- model_comparison.csv\n","- elastic_net_cross_validation.csv\n","- elastic_net_coefficients.csv\n","- elastic_net_house_model.pkl\n"]}],"source":["# ============================================================\n","# DAY 23 - ADVANCED ELASTIC NET REGRESSION\n","# California Housing Price Prediction\n","# Machine Learning Daily Series\n","# ============================================================\n","\n","# ============================================================\n","# 1. IMPORT LIBRARIES\n","# ============================================================\n","\n","import os\n","import warnings\n","import joblib\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","from sklearn.datasets import fetch_california_housing\n","\n","from sklearn.model_selection import (\n","    train_test_split,\n","    KFold,\n","    GridSearchCV,\n","    cross_validate,\n","    learning_curve\n",")\n","\n","from sklearn.pipeline import Pipeline\n","\n","from sklearn.impute import SimpleImputer\n","\n","from sklearn.preprocessing import StandardScaler\n","\n","from sklearn.linear_model import (\n","    ElasticNet,\n","    Ridge,\n","    Lasso,\n","    LinearRegression\n",")\n","\n","from sklearn.metrics import (\n","    mean_absolute_error,\n","    mean_squared_error,\n","    r2_score\n",")\n","\n","warnings.filterwarnings(\"ignore\")\n","\n","RANDOM_STATE = 42\n","\n","OUTPUT_DIR = \"day23_outputs\"\n","\n","os.makedirs(\n","    OUTPUT_DIR,\n","    exist_ok=True\n",")\n","\n","print(\"Day 23 - Advanced Elastic Net Regression\")\n","\n","\n","# ============================================================\n","# 2. LOAD CALIFORNIA HOUSING DATASET\n","# ============================================================\n","\n","housing = fetch_california_housing(\n","    as_frame=True\n",")\n","\n","df = housing.frame.copy()\n","\n","print(\"\\n========== DATASET ==========\")\n","\n","print(\"Shape:\", df.shape)\n","\n","display(df.head())\n","\n","\n","# ============================================================\n","# 3. DATA INFORMATION\n","# ============================================================\n","\n","print(\"\\n========== DATA TYPES ==========\")\n","\n","print(df.dtypes)\n","\n","print(\"\\n========== MISSING VALUES ==========\")\n","\n","print(df.isnull().sum())\n","\n","print(\"\\n========== STATISTICS ==========\")\n","\n","display(df.describe())\n","\n","\n","# ============================================================\n","# 4. FEATURE ENGINEERING\n","# ============================================================\n","\n","# Rooms per household\n","df[\"Rooms_Per_Household\"] = (\n","    df[\"AveRooms\"] /\n","    df[\"AveOccup\"].replace(0, np.nan)\n",")\n","\n","# Bedrooms per room\n","df[\"Bedrooms_Per_Room\"] = (\n","    df[\"AveBedrms\"] /\n","    df[\"AveRooms\"].replace(0, np.nan)\n",")\n","\n","# Population per household\n","df[\"Population_Per_Household\"] = (\n","    df[\"Population\"] /\n","    df[\"AveOccup\"].replace(0, np.nan)\n",")\n","\n","# Income × Age\n","df[\"Income_Age_Interaction\"] = (\n","    df[\"MedInc\"] *\n","    df[\"HouseAge\"]\n",")\n","\n","# Income × Rooms\n","df[\"Income_Rooms_Interaction\"] = (\n","    df[\"MedInc\"] *\n","    df[\"AveRooms\"]\n",")\n","\n","# Income × Occupancy\n","df[\"Income_Occupancy_Interaction\"] = (\n","    df[\"MedInc\"] *\n","    df[\"AveOccup\"]\n",")\n","\n","# Geographic interaction\n","df[\"Latitude_Longitude\"] = (\n","    df[\"Latitude\"] *\n","    df[\"Longitude\"]\n",")\n","\n","df = df.replace(\n","    [np.inf, -np.inf],\n","    np.nan\n",")\n","\n","print(\"\\n========== FEATURE ENGINEERING ==========\")\n","\n","print(\n","    \"Total features after engineering:\",\n","    df.drop(\"MedHouseVal\", axis=1).shape[1]\n",")\n","\n","\n","# ============================================================\n","# 5. FEATURES AND TARGET\n","# ============================================================\n","\n","X = df.drop(\n","    \"MedHouseVal\",\n","    axis=1\n",")\n","\n","y = df[\"MedHouseVal\"]\n","\n","print(\"\\nFeatures:\")\n","\n","print(\n","    X.columns.tolist()\n",")\n","\n","\n","# ============================================================\n","# 6. TRAIN / VALIDATION / TEST SPLIT\n","# ============================================================\n","\n","X_train_full, X_test, y_train_full, y_test = (\n","    train_test_split(\n","        X,\n","        y,\n","        test_size=0.20,\n","        random_state=RANDOM_STATE\n","    )\n",")\n","\n","X_train, X_validation, y_train, y_validation = (\n","    train_test_split(\n","        X_train_full,\n","        y_train_full,\n","        test_size=0.20,\n","        random_state=RANDOM_STATE\n","    )\n",")\n","\n","print(\"\\n========== DATA SPLIT ==========\")\n","\n","print(\"Training:\", X_train.shape)\n","\n","print(\"Validation:\", X_validation.shape)\n","\n","print(\"Testing:\", X_test.shape)\n","\n","\n","# ============================================================\n","# 7. PREPROCESSING PIPELINE\n","# ============================================================\n","\n","preprocessor = Pipeline(\n","    steps=[\n","        (\n","            \"imputer\",\n","            SimpleImputer(\n","                strategy=\"median\"\n","            )\n","        ),\n","\n","        (\n","            \"scaler\",\n","            StandardScaler()\n","        )\n","    ]\n",")\n","\n","\n","# ============================================================\n","# 8. ELASTIC NET PIPELINE\n","# ============================================================\n","\n","elastic_pipeline = Pipeline(\n","    steps=[\n","        (\n","            \"preprocessor\",\n","            preprocessor\n","        ),\n","\n","        (\n","            \"model\",\n","            ElasticNet(\n","                max_iter=20000,\n","                random_state=RANDOM_STATE\n","            )\n","        )\n","    ]\n",")\n","\n","\n","# ============================================================\n","# 9. ELASTIC NET HYPERPARAMETER GRID\n","# ============================================================\n","\n","# alpha controls total regularization strength\n","#\n","# l1_ratio controls the balance:\n","#\n","# l1_ratio = 1.0 -> Lasso\n","# l1_ratio = 0.0 -> Ridge-like behavior\n","# 0 < l1_ratio < 1 -> Elastic Net\n","\n","alpha_values = [\n","    0.0001,\n","    0.0005,\n","    0.001,\n","    0.005,\n","    0.01,\n","    0.05,\n","    0.1,\n","    0.5,\n","    1.0\n","]\n","\n","l1_ratio_values = [\n","    0.05,\n","    0.10,\n","    0.20,\n","    0.30,\n","    0.50,\n","    0.70,\n","    0.80,\n","    0.90,\n","    0.95\n","]\n","\n","param_grid = {\n","    \"model__alpha\": alpha_values,\n","    \"model__l1_ratio\": l1_ratio_values\n","}\n","\n","\n","# ============================================================\n","# 10. 5-FOLD CROSS VALIDATION\n","# ============================================================\n","\n","cv = KFold(\n","    n_splits=5,\n","    shuffle=True,\n","    random_state=RANDOM_STATE\n",")\n","\n","\n","# ============================================================\n","# 11. GRID SEARCH\n","# ============================================================\n","\n","grid_search = GridSearchCV(\n","    estimator=elastic_pipeline,\n","    param_grid=param_grid,\n","    scoring=\"neg_root_mean_squared_error\",\n","    cv=cv,\n","    n_jobs=-1,\n","    return_train_score=True\n",")\n","\n","print(\n","    \"\\n========== STARTING GRID SEARCH ==========\"\n",")\n","\n","grid_search.fit(\n","    X_train,\n","    y_train\n",")\n","\n","print(\n","    \"\\nGrid Search Completed!\"\n",")\n","\n","\n","# ============================================================\n","# 12. BEST PARAMETERS\n","# ============================================================\n","\n","print(\n","    \"\\n========== BEST PARAMETERS ==========\"\n",")\n","\n","print(\n","    \"Best Alpha:\",\n","    grid_search.best_params_[\n","        \"model__alpha\"\n","    ]\n",")\n","\n","print(\n","    \"Best L1 Ratio:\",\n","    grid_search.best_params_[\n","        \"model__l1_ratio\"\n","    ]\n",")\n","\n","print(\n","    \"Best CV RMSE:\",\n","    -grid_search.best_score_\n",")\n","\n","\n","# ============================================================\n","# 13. BEST MODEL\n","# ============================================================\n","\n","best_model = grid_search.best_estimator_\n","\n","\n","# ============================================================\n","# 14. VALIDATION PERFORMANCE\n","# ============================================================\n","\n","validation_predictions = (\n","    best_model.predict(\n","        X_validation\n","    )\n",")\n","\n","validation_mae = mean_absolute_error(\n","    y_validation,\n","    validation_predictions\n",")\n","\n","validation_mse = mean_squared_error(\n","    y_validation,\n","    validation_predictions\n",")\n","\n","validation_rmse = np.sqrt(\n","    validation_mse\n",")\n","\n","validation_r2 = r2_score(\n","    y_validation,\n","    validation_predictions\n",")\n","\n","print(\n","    \"\\n========== VALIDATION PERFORMANCE ==========\"\n",")\n","\n","print(\n","    f\"MAE  : {validation_mae:.4f}\"\n",")\n","\n","print(\n","    f\"MSE  : {validation_mse:.4f}\"\n",")\n","\n","print(\n","    f\"RMSE : {validation_rmse:.4f}\"\n",")\n","\n","print(\n","    f\"R²   : {validation_r2:.4f}\"\n",")\n","\n","\n","# ============================================================\n","# 15. FINAL TEST PERFORMANCE\n","# ============================================================\n","\n","test_predictions = (\n","    best_model.predict(\n","        X_test\n","    )\n",")\n","\n","test_mae = mean_absolute_error(\n","    y_test,\n","    test_predictions\n",")\n","\n","test_mse = mean_squared_error(\n","    y_test,\n","    test_predictions\n",")\n","\n","test_rmse = np.sqrt(\n","    test_mse\n",")\n","\n","test_r2 = r2_score(\n","    y_test,\n","    test_predictions\n",")\n","\n","print(\n","    \"\\n========== FINAL TEST PERFORMANCE ==========\"\n",")\n","\n","print(\n","    f\"MAE  : {test_mae:.4f}\"\n",")\n","\n","print(\n","    f\"MSE  : {test_mse:.4f}\"\n",")\n","\n","print(\n","    f\"RMSE : {test_rmse:.4f}\"\n",")\n","\n","print(\n","    f\"R²   : {test_r2:.4f}\"\n",")\n","\n","\n","# ============================================================\n","# 16. ELASTIC NET COEFFICIENTS\n","# ============================================================\n","\n","elastic_model = best_model.named_steps[\n","    \"model\"\n","]\n","\n","coefficients = pd.DataFrame({\n","    \"Feature\": X.columns,\n","    \"Coefficient\": elastic_model.coef_\n","})\n","\n","coefficients[\n","    \"Absolute_Coefficient\"\n","] = coefficients[\n","    \"Coefficient\"\n","].abs()\n","\n","coefficients[\n","    \"Selected\"\n","] = (\n","    coefficients[\n","        \"Coefficient\"\n","    ] != 0\n",")\n","\n","coefficients = (\n","    coefficients\n","    .sort_values(\n","        \"Absolute_Coefficient\",\n","        ascending=False\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","print(\n","    \"\\n========== ELASTIC NET COEFFICIENTS ==========\"\n",")\n","\n","display(\n","    coefficients\n",")\n","\n","\n","# ============================================================\n","# 17. FEATURE SELECTION\n","# ============================================================\n","\n","selected_features = coefficients[\n","    coefficients[\"Selected\"]\n","]\n","\n","removed_features = coefficients[\n","    ~coefficients[\"Selected\"]\n","]\n","\n","print(\n","    \"\\n========== FEATURE SELECTION ==========\"\n",")\n","\n","print(\n","    \"Total Features:\",\n","    len(coefficients)\n",")\n","\n","print(\n","    \"Selected Features:\",\n","    len(selected_features)\n",")\n","\n","print(\n","    \"Zero Coefficient Features:\",\n","    len(removed_features)\n",")\n","\n","\n","# ============================================================\n","# 18. COEFFICIENT PLOT\n","# ============================================================\n","\n","plot_data = coefficients.sort_values(\n","    \"Coefficient\"\n",")\n","\n","plt.figure(\n","    figsize=(10, 8)\n",")\n","\n","plt.barh(\n","    plot_data[\"Feature\"],\n","    plot_data[\"Coefficient\"]\n",")\n","\n","plt.axvline(\n","    0,\n","    linestyle=\"--\"\n",")\n","\n","plt.xlabel(\n","    \"Elastic Net Coefficient\"\n",")\n","\n","plt.ylabel(\n","    \"Feature\"\n",")\n","\n","plt.title(\n","    \"Elastic Net Feature Coefficients\"\n",")\n","\n","plt.tight_layout()\n
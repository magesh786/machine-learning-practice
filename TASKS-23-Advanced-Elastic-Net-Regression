n_scores.mean(\n","    axis=1\n",")\n","\n","plt.figure(\n","    figsize=(9, 6)\n",")\n","\n","plt.plot(\n","    train_sizes,\n","    train_rmse,\n","    marker=\"o\",\n","    label=\"Training RMSE\"\n",")\n","\n","plt.plot(\n","    train_sizes,\n","    validation_rmse,\n","    marker=\"o\",\n","    label=\"Validation RMSE\"\n",")\n","\n","plt.xlabel(\n","    \"Training Samples\"\n",")\n","\n","plt.ylabel(\n","    \"RMSE\"\n",")\n","\n","plt.title(\n","    \"Elastic Net Learning Curve\"\n",")\n","\n","plt.legend()\n","\n","plt.grid(\n","    alpha=0.3\n",")\n","\n","plt.tight_layout()\n","\n","plt.savefig(\n","    f\"{OUTPUT_DIR}/learning_curve.png\",\n","    dpi=150\n",")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 29. PREDICTION RESULTS\n","# ============================================================\n","\n","prediction_results = X_test.copy()\n","\n","prediction_results[\n","    \"Actual_House_Value\"\n","] = y_test.values\n","\n","prediction_results[\n","    \"Predicted_House_Value\"\n","] = test_predictions\n","\n","prediction_results[\n","    \"Residual\"\n","] = residuals.values\n","\n","prediction_results[\n","    \"Absolute_Error\"\n","] = np.abs(\n","    residuals.values\n",")\n","\n","display(\n","    prediction_results.head()\n",")\n","\n","\n","# ============================================================\n","# 30. LARGEST ERRORS\n","# ============================================================\n","\n","largest_errors = (\n","    prediction_results\n","    .sort_values(\n","        \"Absolute_Error\",\n","        ascending=False\n","    )\n","    .head(20)\n",")\n","\n","print(\n","    \"\\n========== LARGEST PREDICTION ERRORS ==========\"\n",")\n","\n","display(\n","    largest_errors\n",")\n","\n","\n","# ============================================================\n","# 31. MODEL COMPARISON\n","# ============================================================\n","\n","comparison_models = {\n"
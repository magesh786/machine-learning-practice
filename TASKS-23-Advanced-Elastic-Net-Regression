_Zero_Features\":\n","            non_zero_features\n","    })\n","\n","\n","alpha_experiment = pd.DataFrame(\n","    alpha_experiment\n",")\n","\n","display(\n","    alpha_experiment\n",")\n","\n","\n","# ============================================================\n","# 23. L1 RATIO EXPERIMENT\n","# ============================================================\n","\n","l1_experiment = []\n","\n","best_alpha = (\n","    grid_search.best_params_[\n","        \"model__alpha\"\n","    ]\n",")\n","\n","for ratio in l1_ratio_values:\n","\n","    model = Pipeline(\n","        steps=[\n","            (\n","                \"preprocessor\",\n","                preprocessor\n","            ),\n","\n","            (\n","                \"model\",\n","                ElasticNet(\n","                    alpha=best_alpha,\n","                    l1_ratio=ratio,\n","                    max_iter=20000,\n","                    random_state=RANDOM_STATE\n","                )\n","            )\n","        ]\n","    )\n","\n","    model.fit(\n","        X_train,\n","        y_train\n","    )\n","\n","    predictions = model.predict(\n","        X_validation\n","    )\n","\n","    rmse = np.sqrt(\n","        mean_squared_error(\n","            y_validation,\n","            predictions\n","        )\n","    )\n","\n","    r2 = r2_score(\n","        y_validation,\n","        predictions\n","    )\n","\n","    coefficient_values = (\n","        model\n","        .named_steps[\"model\"]\n","        .coef_\n","    )\n","\n","    non_zero = np.sum(\n","        coefficient_values != 0\n","    )\n","\n","    l1_experiment.append({\n","        \"L1_Ratio\": ratio,\n","        \"Alpha\": best_alpha,\n","        \"RMSE\": rmse,\n","        \"R2\": r2,\n","        \"Non_Zero_Features\": non_zero\n","    })\n","\n","\n","l1_experiment = pd.DataFrame(\n","    l1_experiment\n",")\n","\n","display(\n","    l1_experiment\n",")\n","\n","\n","# ============================================================
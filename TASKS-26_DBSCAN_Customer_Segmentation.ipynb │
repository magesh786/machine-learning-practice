 CUSTOMER SEGMENTATION\n","# Density-Based Spatial Clustering of Applications with Noise\n","# ============================================================\n","\n","# ============================================================\n","# 1. IMPORT LIBRARIES\n","# ============================================================\n","\n","import os\n","import warnings\n","import joblib\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.cluster import DBSCAN\n","from sklearn.decomposition import PCA\n","from sklearn.metrics import (\n","    silhouette_score,\n","    calinski_harabasz_score,\n","    davies_bouldin_score\n",")\n","\n","warnings.filterwarnings(\"ignore\")\n","\n","RANDOM_STATE = 42\n","\n","OUTPUT_DIR = \"day26_outputs\"\n","os.makedirs(OUTPUT_DIR, exist_ok=True)\n","\n","np.random.seed(RANDOM_STATE)\n","\n","print(\"Libraries imported successfully.\")\n","\n","\n","# ============================================================\n","# 2. CREATE CUSTOMER DATASET\n","# ============================================================\n","\n","n_customers = 1200\n","\n","customer_data = []\n","\n","# ------------------------------------------------------------\n","# Segment 1: Regular customers\n","# ------------------------------------------------------------\n","\n","segment_1 = pd.DataFrame({\n","    \"Age\": np.random.normal(28, 5, 400),\n","    \"Annual_Income\": np.random.normal(40000, 8000, 400),\n","    \"Purchase_Frequency\": np.random.normal(8, 2, 400),\n","    \"Average_Order_Value\": np.random.normal(50, 10, 400),\n","    \"Website_Visits\": np.random.normal(35, 8, 400),\n","    \"Discount_Usage\": np.random.normal(60, 10, 400)\n","})\n","\n","# ------------------------------------------------------------\n","# Segment 2: High-value customers\n","# ------------------------------------------------------------\n","\n","segment_2 = pd.DataFrame({\n","    \"Age\": np.random.normal(42, 6, 350),\n","    \"Annual_Income\": np.random.normal(95000, 12000, 350),\n","    \"Purchase_Frequency\": np.random.normal(18, 3, 350),\n","    \"Average_Order_Value\": np.random.normal(150, 25, 350),\n","    \"Website_Visits\": np.random.normal(75, 12, 350),\n","    \"Discount_Usage\": np.random.normal(25, 8, 350)\n","})\n","\n","# ------------------------------------------------------------\n","# Segment 3: Budget frequent customers\n","# ------------------------------------------------------------\n","\n","segment_3 = pd.DataFrame({\n","    \"Age\": np.random.normal(25, 4, 300),\n","    \"Annual_Income\": np.random.normal(28000, 5000, 300),\n","    \"Purchase_Frequency\": np.random.normal(20, 3, 300),\n","    \"Average_Order_Value\": np.random.normal(35, 8, 300),\n","    \"Website_Visits\": np.random.normal(80, 15, 300),\n","    \"Discount_Usage\": np.random.normal(75, 10, 300)\n","})\n","\n","# ------------------------------------------------------------\n","# Combine segments\n","# ------------------------------------------------------------\n","\n","customer_df = pd.concat(\n","    [segment_1, segment_2, segment_3],\n","    ignore_index=True\n",")\n","\n","# ------------------------------------------------------------\n","# Add noise / unusual customers\n","# ------------------------------------------------------------\n","\n","n_outliers = 50\n","\n","outliers = pd.DataFrame({\n","    \"Age\": np.random.uniform(18, 70, n_outliers),\n","    \"Annual_Income\": np.random.uniform(\n","        10000, 180000, n_outliers\n","    ),\n","    \"Purchase_Frequency\": np.random.uniform(\n","        1, 50, n_outliers\n","    ),\n","    \"Average_Order_Value\": np.random.uniform(\n","        10, 500, n_outliers\n","    ),\n","    \"Website_Visits\": np.random.uniform(\n","        1, 200, n_outliers\n","    ),\n","    \"Discount_Usage\": np.random.uniform(\n","        0, 100, n_outliers\n","    )\n","})\n","\n","customer_df = pd.concat(\n","    [customer_df, outliers],\n","    ignore_index=True\n",")\n","\n","# Clip unrealistic values\n","customer_df[\"Age\"] = customer_df[\"Age\"].clip(18, 75)\n","customer_df[\"Annual_Income\"] = customer_df[\n","    \"Annual_Income\"\n","].clip(10000, 200000)\n","\n","customer_df[\"Purchase_Frequency\"] = customer_df[\n","    \"Purchase_Frequency\"\n","].clip(1, 50)\n","\n","customer_df[\"Average_Order_Value\"] = customer_df[\n","    \"Average_Order_Value\"\n","].clip(5, 500)\n","\n","customer_df[\"Website_Visits\"] = customer_df[\n","    \"Website_Visits\"\n","].clip(1, 200)\n","\n","customer_df[\"Discount_Usage\"] = customer_df[\n","    \"Discount_Usage\"\n","].clip(0, 100)\n","\n","customer_df.insert(\n","    0,\n","    \"Customer_ID\",\n","    range(1, len(customer_df) + 1)\n",")\n","\n","customer_df = customer_df.round(2)\n","\n","print(\"Dataset shape:\", customer_df.shape)\n","\n","display(customer_df.head())\n","\n","\n","# ============================================================\n","# 3. DATA EXPLORATION\n","# ============================================================\n","\n","print(\"\\nDataset information:\")\n","customer_df.info()\n","\n","print(\"\\nMissing values:\")\n","print(customer_df.isnull().sum())\n","\n","print(\"\\nStatistical summary:\")\n","display(customer_df.describe())\n","\n","\n","# ============================================================\n","# 4. SAVE RAW DATA\n","# ============================================================\n","\n","customer_df.to_csv(\n","    f\"{OUTPUT_DIR}/customer_dataset.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 5. SELECT FEATURES\n","# ============================================================\n","\n","features = [\n","    \"Age\",\n","    \"Annual_Income\",\n","    \"Purchase_Frequency\",\n","    \"Average_Order_Value\",\n","    \"Website_Visits\",\n","    \"Discount_Usage\"\n","]\n","\n","X = customer_df[features].copy()\n","\n","\n","# ============================================================\n","# 6. STANDARDIZE DATA\n","# ============================================================\n","\n","scaler = StandardScaler()\n","\n","X_scaled = scaler.fit_transform(X)\n","\n","print(\"Feature scaling completed.\")\n","\n","\n","# ============================================================\n","# 7. INITIAL DBSCAN MODEL\n","# ============================================================\n","\n","dbscan = DBSCAN(\n","    eps=0.8,\n","    min_samples=10\n",")\n","\n","cluster_labels = dbscan.fit_predict(X_scaled)\n","\n","customer_df[\"Cluster\"] = cluster_labels\n","\n","\n","# ============================================================\n","# 8. ANALYZE CLUSTERS\n","# ============================================================\n","\n","unique_clusters = sorted(\n","    customer_df[\"Cluster\"].unique()\n",")\n","\n","print(\"\\nDetected clusters:\")\n","print(unique_clusters)\n","\n","n_clusters = len(\n","    set(cluster_labels)\n",") - (1 if -1 in cluster_labels else 0)\n","\n","n_noise = np.sum(\n","    cluster_labels == -1\n",")\n","\n","print(\"\\nNumber of clusters:\", n_clusters)\n","print(\"Number of noise points:\", n_noise)\n","\n","print(\"\\nCluster distribution:\")\n","print(\n","    customer_df[\"Cluster\"]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","\n","# ============================================================\n","# 9. NOISE / OUTLIER ANALYSIS\n","# ============================================================\n","\n","customer_df[\"Is_Noise\"] = (\n","    customer_df[\"Cluster\"] == -1\n",")\n","\n","noise_customers = customer_df[\n","    customer_df[\"Is_Noise\"]\n","].copy()\n","\n","print(\"\\nNoise customers:\")\n","display(noise_customers.head(20))\n","\n","noise_customers.to_csv(\n","    f\"{OUTPUT_DIR}/noise_customers.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 10. PCA FOR VISUALIZATION\n","# ============================================================\n","\n","pca = PCA(\n","    n_components=2,\n","    random_state=RANDOM_STATE\n",")\n","\n","X_pca = pca.fit_transform(X_scaled)\n","\n","customer_df[\"PCA_1\"] = X_pca[:, 0]\n","customer_df[\"PCA_2\"] = X_pca[:, 1]\n","\n","print(\n","    \"PCA explained variance:\",\n","    pca.explained_variance_ratio_\n",")\n","\n","print(\n","    \"Total explained variance:\",\n","    pca.explained_variance_ratio_.sum()\n",")\n","\n","\n","# ============================================================\n","# 11. VISUALIZE DBSCAN CLUSTERS\n","# ============================================================\n","\n","plt.figure(figsize=(12, 8))\n","\n","scatter = plt.scatter(\n","    customer_df[\"PCA_1\"],\n","    customer_df[\"PCA_2\"],\n","    c=customer_df[\"Cluster\"],\n","    alpha=0.7\n",")\n","\n","plt.xlabel(\"Principal Component 1\")\n","plt.ylabel(\"Principal Component 2\")\n","\n","plt.title(\n","    \"Customer Segmentation using DBSCAN\"\n",")\n","\n","plt.colorbar(\n","    scatter,\n","    label=\"Cluster\"\n",")\n","\n","plt.grid(True)\n","plt.tight_layout()\n","\n","plt.savefig(\n","    f\"{OUTPUT_DIR}/dbscan_clusters.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 12. VISUALIZE NOISE POINTS\n","# ============================================================\n","\n","plt.figure(figsize=(12, 8))\n","\n","normal_points = customer_df[\n","    customer_df[\"Cluster\"] != -1\n","]\n","\n","noise_points = customer_df[\n","    customer_df[\"Cluster\"] == -1\n","]\n","\n","plt.scatter(\n","    normal_points[\"PCA_1\"],\n","    normal_points[\"PCA_2\"],\n","    alpha=0.6,\n","    label=\"Clustered Customers\"\n",")\n","\n","plt.scatter(\n","    noise_points[\"PCA_1\"],\n","    noise_points[\"PCA_2\"],\n","    marker=\"x\",\n","    s=80,\n","    label=\"Noise / Outliers\"\n",")\n","\n","plt.xlabel(\"Principal Component 1\")\n","plt.ylabel(\"Principal Component 2\")\n","\n","plt.title(\n","    \"DBSCAN: Clustered Customers vs Noise\"\n",")\n","\n","plt.legend()\n","plt.grid(True)\n","plt.tight_layout()\n","\n","plt.savefig(\n","    f\"{OUTPUT_DIR}/dbscan_noise.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 13. EVALUATION METRICS\n","# ============================================================\n","\n","valid_mask = (\n","    customer_df[\"Cluster\"] != -1\n",")\n","\n","X_valid = X_scaled[valid_mask]\n","\n","labels_valid = (\n","    customer_df.loc[\n","        valid_mask,\n","        \"Cluster\"\n","    ]\n",")\n","\n","if len(set(labels_valid)) \u003e= 2:\n","\n","    silhouette = silhouette_score(\n","        X_valid,\n","        labels_valid\n","    )\n","\n","    calinski = calinski_harabasz_score(\n","        X_valid,\n","        labels_valid\n","    )\n","\n","    davies = davies_bouldin_score(\n","        X_valid,\n","        labels_valid\n","    )\n","\n","else:\n","\n","    silhouette = np.nan\n","    calinski = np.nan\n","    davies = np.nan\n","\n","\n","metrics_df = pd.DataFrame({\n","    \"Metric\": [\n","        \"Number of Clusters\",\n","        \"Noise Points\",\n","        \"Noise Percentage\",\n","        \"Silhouette Score\",\n","        \"Calinski-Harabasz Score\",\n","        \"Davies-Bouldin Score\"\n","    ],\n","    \"Value\": [\n","        n_clusters,\n","        n_noise,\n","        (n_noise / len(customer_df)) * 100,\n","        silhouette,\n","        calinski,\n","        davies\n","    ]\n","})\n","\n","print(\"\\nDBSCAN Evaluation:\")\n","display(metrics_df)\n","\n","metrics_df.to_csv(\n","    f\"{OUTPUT_DIR}/dbscan_metrics.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 14. TEST DIFFERENT EPS VALUES\n","# ============================================================\n","\n","eps_values = np.arange(\n","    0.3,\n","    1.51,\n","    0.1\n",")\n","\n","eps_results = []\n","\n","for eps in eps_values:\n","\n","    model = DBSCAN(\n","        eps=eps,\n","        min_samples=10\n","    )\n","\n","    labels = model.fit_predict(X_scaled)\n","\n","    clusters = len(\n","        set(labels)\n","    ) - (1 if -1 in labels else 0)\n","\n","    noise_count = np.sum(\n","        labels == -1\n","    )\n","\n","    valid = labels != -1\n","\n","    if (\n","        clusters \u003e= 2\n","        and valid.sum() \u003e clusters\n","    ):\n","\n","        score = silhouette_score(\n","            X_scaled[valid],\n","            labels[valid]\n","        )\n","\n","    else:\n","\n","        score = np.nan\n","\n","    eps_results.append({\n","        \"eps\": eps,\n","        \"clusters\": clusters,\n","        \"noise_points\": noise_count,\n","        \"noise_percentage\":\n","            noise_count / len(labels) * 100,\n","        \"silhouette_score\": score\n","    })\n","\n","\n","eps_results_df = pd.DataFrame(\n","    eps_results\n",")\n","\n","display(eps_results_df)\n","\n","eps_results_df.to_csv(\n","    f\"{OUTPUT_DIR}/eps_analysis.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 15. PLOT EPS ANALYSIS\n","# ============================================================\n","\n","plt.figure(figsize=(12, 6))\n","\n","plt.plot(\n","    eps_results_df[\"eps\"],\n","    eps_results_df[\"silhouette_score\"],\n","    marker=\"o\"\n",")\n","\n","plt.xlabel(\"eps\")\n","plt.ylabel(\"Silhouette Score\")\n","\n","plt.title(\n","    \"DBSCAN eps Parameter Analysis\"\n",")\n","\n","plt.grid(True)\n","plt.tight_layout()\n","\n","plt.savefig(\n","    f\"{OUTPUT_DIR}/eps_silhouette_analysis.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 16. FIND BEST EPS FROM SILHOUETTE SCORE\n","# ============================================================\n","\n","valid_eps_results = (\n","    eps_results_df\n","    .dropna(\n","        subset=[\"silhouette_score\"]\n","    )\n",")\n","\n","if len(valid_eps_results) \u003e 0:\n","\n","    best_eps = valid_eps_results.loc[\n","        valid_eps_results[\n","            \"silhouette_score\"\n","        ].idxmax(),\n","        \"eps\"\n","    ]\n","\n","else:\n","\n","    best_eps = 0.8\n","\n","print(\n","    f\"Selected eps based on \"\n","    f\"silhouette analysis: {best_eps:.2f}\"\n",")\n","\n","\n","# ============================================================\n","# 17. FINAL OPTIMIZED DBSCAN\n","# ============================================================\n","\n","final_dbscan = DBSCAN(\n","    eps=float(best_eps),\n","    min_samples=10\n",")\n","\n","final_labels = final_dbscan.fit_predict(\n","    X_scaled\n",")\n","\n","customer_df[\"Final_Cluster\"] = final_labels\n","\n","final_n_clusters = len(\n","    set(final_labels)\n",") - (1 if -1 in final_labels else 0)\n","\n","final_noise = np.sum(\n","    final_labels == -1\n",")\n","\n","print(\"\\nFinal DBSCAN Results\")\n","print(\"=\" * 45)\n","\n","print(\n","    \"Clusters:\",\n","    final_n_clusters\n",")\n","\n","print(\n","    \"Noise points:\",\n","    final_noise\n",")\n","\n","print(\n","    \"Noise percentage:\",\n","    round(\n","        final_noise / len(final_labels) * 100,\n","        2\n","    )\n",")\n","\n","\n","# ============================================================\n","# 18. FINAL CLUSTER PROFILE\n","# ============================================================\n","\n","clustered_customers = customer_df[\n","    customer_df[\"Final_Cluster\"] != -1\n","]\n","\n","cluster_profile = (\n","    clustered_customers\n","    .groupby(\"Final_Cluster\")[features]\n","    .mean()\n",")\n","\n","print(\"\\nFinal Cluster Profile:\")\n","display(cluster_profile)\n","\n","cluster_profile.to_csv(\n","    f\"{OUTPUT_DIR}/cluster_profile.csv\"\n",")\n","\n","\n","# ============================================================\n","# 19. FINAL CLUSTER SIZE\n","# ============================================================\n","\n","cluster_size = (\n","    customer_df[\"Final_Cluster\"]\n","    .value_counts()\n","    .sort_index()\n","    .reset_index()\n",")\n","\n","cluster_size.columns = [\n","    \"Cluster\",\n","    \"Customer_Count\"\n","]\n","\n","cluster_size[\"Percentage\"] = (\n","    cluster_size[\"Customer_Count\"]\n","    / len(customer_df)\n","    * 100\n",")\n","\n","display(cluster_size)\n","\n","cluster_size.to_csv(\n","    f\"{OUTPUT_DIR}/cluster_size.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 20. FINAL VISUALIZATION\n","# ============================================================\n","\n","plt.figure(figsize=(12, 8))\n","\n","scatter = plt.scatter(\n","    customer_df[\"PCA_1\"],\n","    customer_df[\"PCA_2\"],\n","    c=customer_df[\"Final_Cluster\"],\n","    alpha=0.7\n",")\n","\n","plt.xlabel(\"Principal Component 1\")\n","plt.ylabel(\"Principal Component 2\")\n","\n","plt.title(\n","    \"Final DBSCAN Customer Segmentation\"\n",")\n","\n","plt.colorbar(\n","    scatter,\n","    label=\"Cluster\"\n",")\n","\n","plt.grid(True)\n","plt.tight_layout()\n","\n","plt.savefig(\n","    f\"{OUTPUT_DIR}/final_dbscan_clusters.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 21. INCOME VS PURCHASE FREQUENCY\n","# ============================================================\n","\n","plt.figure(figsize=(12, 8))\n","\n","scatter = plt.scatter(\n","    customer_df[\"Annual_Income\"],\n","    customer_df[\"Purchase_Frequency\"],\n","    c=customer_df[\"Final_Cluster\"],\n","    alpha=0.7\n",")\n","\n","plt.xlabel(\"Annual Income\")\n","plt.ylabel(\"Purchase Frequency\")\n","\n","plt.title(\n","    \"DBSCAN Segmentation: Income vs Purchase Frequency\"\n",")\n","\n","plt.colorbar(\n","    scatter,\n","    label=\"Cluster\"\n",")\n","\n","plt.grid(True)\n","plt.tight_layout()\n","\n","plt.savefig(\n","    f\"{OUTPUT_DIR}/income_purchase_dbscan.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 22. IDENTIFY CORE SAMPLES\n","# ============================================================\n","\n","core_sample_indices = (\n","    final_dbscan.core_sample_indices_\n",")\n","\n","core_sample_mask = np.zeros(\n","    len(customer_df),\n","    dtype=bool\n",")\n","\n","core_sample_mask[\n","    core_sample_indices\n","] = True\n","\n","customer_df[\"Is_Core_Point\"] = (\n","    core_sample_mask\n",")\n","\n","print(\n","    \"\\nCore points:\",\n","    core_sample_mask.sum()\n",")\n","\n","print(\n","    \"Non-core points:\",\n","    (~core_sample_mask).sum()\n",")\n","\n","\n","# ============================================================\n","# 23. SAVE CORE / BORDER / NOISE INFORMATION\n","# ============================================================\n","\n","customer_df[\"Point_Type\"] = \"Border\"\n","\n","customer_df.loc[\n","    customer_df[\"Is_Core_Point\"],\n","    \"Point_Type\"\n","] = \"Core\"\n","\n","customer_df.loc[\n","    customer_df[\"Final_Cluster\"] == -1,\n","    \"Point_Type\"\n","] = \"Noise\"\n","\n","print(\"\\nPoint Type Distribution:\")\n","print(\n","    customer_df[\"Point_Type\"]\n","    .value_counts()\n",")\n","\n","point_type_df = (\n","    customer_df[\n","        [\n","            \"Customer_ID\",\n","            \"Final_Cluster\",\n","            \"Point_Type\"\n","        ]\n","    ]\n",")\n","\n","point_type_df.to_csv(\n","    f\"{OUTPUT_DIR}/point_type_analysis.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 24. SAVE FINAL CUSTOMER DATA\n","# ============================================================\n","\n","final_customer_data = customer_df[\n","    [\n","        \"Customer_ID\",\n","        \"Age\",\n","        \"Annual_Income\",\n","        \"Purchase_Frequency\",\n","        \"Average_Order_Value\",\n","        \"Website_Visits\",\n","        \"Discount_Usage\",\n","        \"Final_Cluster\",\n","        \"Point_Type\"\n","    ]\n","]\n","\n","display(\n","    final_customer_data.head(20)\n",")\n","\n","final_customer_data.to_csv(\n","    f\"{OUTPUT_DIR}/final_customer_segments.csv\",\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# 25. SAVE SCALER\n","# ============================================================\n","\n","joblib.dump(\n","    scaler,\n","    f\"{OUTPUT_DIR}/customer_scaler.pkl\"\n",")\n","\n","\n","# ============================================================\n","# 26. SAVE PCA\n","# ============================================================\n","\n","joblib.dump(\n","    pca,\n","    f\"{OUTPUT_DIR}/customer_pca.pkl\"\n",")\n","\n","\n","# ============================================================\n","# 27. SAVE DBSCAN CONFIGURATION\n","# ============================================================\n","\n","dbscan_config = {\n","    \"algorithm\": \"DBSCAN\",\n","    \"eps\": float(best_eps),\n","    \"min_samples\": 10,\n","    \"features\": features,\n","    \"n_clusters\": int(final_n_clusters),\n","    \"noise_points\": int(final_noise)\n","}\n","\n","joblib.dump(\n","    dbscan_config,\n","    f\"{OUTPUT_DIR}/dbscan_config.pkl\"\n",")\n","\n","\n","# ============================================================\n","# 28. NEW CUSTOMER ANALYSIS\n","# ============================================================\n","\n","new_customer = pd.DataFrame({\n","    \"Age\": [30],\n","    \"Annual_Income\": [55000],\n","    \"Purchase_Frequency\": [12],\n","    \"Average_Order_Value\": [75],\n","    \"We
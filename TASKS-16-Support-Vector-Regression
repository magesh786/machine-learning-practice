pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","from sklearn.datasets import fetch_california_housing\n","from sklearn.model_selection import train_test_split\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.svm import SVR\n","\n","from sklearn.metrics import (\n","    mean_absolute_error,\n","    mean_squared_error,\n","    r2_score\n",")\n","\n","# ============================================================\n","# 2. Load Dataset\n","# ============================================================\n","\n","housing = fetch_california_housing()\n","\n","X = housing.data\n","y = housing.target\n","\n","feature_names = housing.feature_names\n","\n","print(\"Dataset Shape:\", X.shape)\n","print(\"Number of Features:\", X.shape[1])\n","\n","# ============================================================\n","# 3. Create DataFrame\n","# ============================================================\n","\n","df = pd.DataFrame(\n","    X,\n","    columns=feature_names\n",")\n","\n","df[\"HouseValue\"] = y\n","\n","print(\"\\nFirst 5 Rows:\")\n","print(df.head())\n","\n","# ============================================================\n","# 4. Dataset Information\n","# ============================================================\n","\n","print(\"\\nDataset Information:\")\n","print(df.info())\n","\n","print(\"\\nStatistical Summary:\")\n","print(df.describe())\n","\n","# ============================================================\n","# 5. Check Missing Values\n","# ============================================================\n","\n","print(\"\\nMissing Values:\")\n","print(df.isnull().sum())\n","\n","# ============================================================\n","# 6. Correlation Matrix\n","# ============================================================\n","\n","plt.figure(figsize=(10, 7))\n","\n","sns.heatmap(\n","    df.corr(),\n","    annot=True,\n","    fmt=\".2f\",\n","    cmap=\"coolwarm\"\n",")\n","\n","plt.title(\"California Housing Correlation Matrix\")\n","plt.show()\n","\n","# ============================================================\n","# 7. Train-Test Split\n","# ============================================================\n","\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X,\n","    y,\n","    test_size=0.20,\n","    random_state=42\n",")\n","\n","print(\"\\nTraining Samples:\", len(X_train))\n","print(\"Testing Samples:\", len(X_test))\n","\n","# ============================================================\n","# 8. Feature Scaling\n","# ============================================================\n","\n","scaler = StandardScaler()\n","\n","X_train_scaled = scaler.fit_transform(X_train)\n","X_test_scaled = scaler.transform(X_test)\n","\n","print(\"\\nFeature Scaling Completed.\")\n","\n","# ============================================================\n","# 9. Create SVR Model\n","# ============================================================\n","\n","model = SVR(\n","    kernel=\"rbf\",\n","    C=100,\n","    gamma=\"scale\",\n","    epsilon=0.1\n",")\n","\n","print(\"\\nSVR Configuration:\")\n","print(\"Kernel   :\", \"RBF\")\n","print(\"C        :\", 100)\n","print(\"Gamma    :\", \"scale\")\n","print(\"Epsilon  :\", 0.1)\n","\n","# ============================================================\n","# 10. Train Model\n","# ============================================================\n","\n","print(\"\\nTraining SVR model...\")\n","\n","model.fit(\n","    X_train_scaled,\n","    y_train\n",")\n","\n","print(\"Training completed.\")\n","\n","# ============================================================\n","# 11. Predictions\n","# ============================================================\n","\n","y_pred = model.predict(\n","    X_test_scaled\n",")\n","\n","# ============================================================\n","# 12. Evaluation Metrics\n","# ============================================================\n","\n","mae = mean_absolute_error(\n","    y_test,\n","    y_pred\n",")\n","\n","mse = mean_squared_error(G\n","    y_test,\n","    y_pred\n",")\n","\n","rmse = np.sqrt(mse)\n","\n","r2 = r2_score(\n","    y_test,\n","    y_pred\n",")\n","\n","print(\"\\n======================================\")\n","print(\"SVR MODEL PERFORMANCE\")\n","print(\"======================================\")\n","\n","print(\"MAE :\", round(mae, 4))\n","print(\"MSE :\", round(mse, 4))\n","print(\"RMSE:\", round(rmse, 4))\n","print(\"R²  :\", round(r2, 4))\n","\n","# ============================================================\n","# 13. Actual vs Predicted\n","# ============================================================\n","\n","results_df = pd.DataFrame({\n","    \"Actual_House_Value\": y_test,\n","    \"Predicted_House_Value\": y_pred\n","})\n","\n","print(\"\\nActual vs Predicted:\")\n","print(results_df.head(10))\n","\n","# ============================================================\n","# 14. Actual vs Predicted Plot\n","# ============================================================\n","\n","plt.figure(figsize=(8, 6))\n","\n","plt.scatter(\n","    y_test,\n","    y_pred,\n","    alpha=0.5\n",")\n","\n","plt.xlabel(\"Actual House Value\")\n","plt.ylabel(\"Predicted House Value\")\n","plt.title(\"SVR - Actual vs Predicted\")\n","\n","# Perfect prediction line\n","minimum = min(\n","    y_test.min(),\n","    y_pred.min()\n",")\n","\n","maximum = max(\n","    y_test.max(),\n","    y_pred.max()\n",")\n","\n","plt.plot(\n","    [minimum, maximum],\n","    [minimum, maximum],\n","    linestyle=\"--\"\n",")\n","\n","plt.show()\n","\n","# ============================================================\n","# 15. Prediction Error Distribution\n","# ============================================================\n","\n","errors = y_test - y_pred\n","\n","plt.figure(figsize=(8, 6))\n","\n","plt.hist(\n","    errors,\n","    bins=30\n",")\n","\n","plt.xlabel(\"Prediction Error\")\n","plt.ylabel(\"Frequency\")\n","plt.title(\"SVR Prediction Error Distribution\")\n","\n","plt.show()\n","\n","# ============================================================\n","# 16. Custom Prediction\n","# ============================================================\n","\n","def predict_house_value(\n","    medinc,\n","    houseage,\n","    averooms,\n","    avebedrms,\n","    population,\n","    aveoccup,\n","    latitude,\n","    longitude\n","):\n","\n","    sample = np.array([\n","        medinc,\n","        houseage,\n","        averooms,\n","        avebedrms,\n","        population,\n","        aveoccup,\n","        latitude,\n","        longitude\n","    ]).reshape(1, -1)\n","\n","    sample_scaled = scaler.transform(\n","        sample\n","    )\n","\n","    prediction = model.predict(\n","        sample_scaled\n","    )\n","\n","    print(\"\\nPredicted House Value:\")\n","    print(\n","        round(prediction[0], 4),\n","        \"($100,000 units)\"\n","    )\n","\n","\n","# Example prediction\n","predict_house_value(\n","    5.0,\n","    20.0,\n","    6.0,\n","    1.0,\n","    1500,\n","    3.0,\n","    34.0,\n","    -118.0\n",")\n","\n","# ============================================================\n","# 17. Save Prediction Results\n","# ============================================================\n","\n","results_df.to_csv(\n","    \"svr_house_predictions.csv\",\n","    index=False\n",")\n","\n","# ============================================================\n","# 18. Save Model Summary\n","# ============================================================\n","\n","model_summary = pd.DataFrame({\n","    \"Model\": [\"Support Vector Regression\"],\n","    \"Kernel\": [\"RBF\"],\n","    \"C\": [100],\n","    \"Gamma\": [\"scale\"],\n","    \"Epsilon\": [0.1],\n","    \"Training_Samples\": [len(X_train)],\n","    \"Testing_Samples\": [len(X_test)],\n","    \"Features\": [X.shape[1]],\n","    \"MAE\": [mae],\n","    \"MSE\": [mse],\n","    \"RMSE\": [rmse],\n","    \"R2_Score\": [r2]\n","})\n","\n","model_summary.to_csv(\n","    \"svr_model_summary.csv\",\n","    index=False\n",")\n","\n","# ============================================================\n","# 19. Save Error Analysis\n","# ============================================================\n","\n","error_df = pd.DataFrame({\n","    \"Actual\": y_test,\n","    \"Predicted\": y_pred,\n","    \"Error\": errors,\n","    \"Absolute_Error\": np.abs(errors)\n","})\n","\n","error_df.to_csv(\n","    \"svr_error_analysis.csv\",\n","    index=False\n",")\n","\n","# ============================================================\n","# 20. Final Output\n","# ============================================================\n","\n","print(\"\\n======================================\")\n","print(\"FILES SAVED SUCCESSFULLY\")\n","print(\"======================================\")\n","\n","print(\"1. svr_house_predictions.csv\")\n","print(\"2. svr_model_summary.csv\")\n","print(\"3. svr_error_analysis.csv\")\n","\n","print(\"\\n🚀 Day 16 completed successfully!\")"]}]}